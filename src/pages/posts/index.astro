---
// 文章库：所有长文。分类在左栏的「库」树里（文章下面那一串），点了原地筛选；标签在下面
import ArticleCard from "../../components/kit/ArticleCard.astro";
import KitHeader from "../../components/kit/KitHeader.astro";
import KitShell from "../../components/kit/KitShell.astro";
import SideTags from "../../components/kit/SideTags.astro";
import Toolbar from "../../components/kit/Toolbar.astro";
import VaultHeader from "../../components/kit/VaultHeader.astro";
import VaultNav from "../../components/kit/VaultNav.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getFeed } from "../../utils/kit/content";

const posts = (await getFeed()).filter((f) => f.kind === "post");

const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.tags.filter((t) => t !== p.category)) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ name, count }));
---

<MainGridLayout title="文章" description="所有文章，按分类和标签筛选">
	<KitShell collection={{ defaultSort: "date", defaultView: "list" }}>
		<Fragment slot="side">
			<VaultHeader />
			<VaultNav active="posts" />
			<SideTags id="kit-tags" title="标签" tags={tags} />
		</Fragment>

		<KitHeader title="文章">
			<Toolbar
				slot="toolbar"
				total={posts.length}
				sorts={[
					{ value: "date", label: "日期" },
					{ value: "title", label: "标题" },
				]}
				defaultSort="date"
				groups={[
					{ value: "cat", label: "分类" },
					{ value: "year", label: "年份" },
					{ value: "tag", label: "标签" },
				]}
				searchPlaceholder="搜索文章"
			/>
		</KitHeader>

		<div class="kit-grid kit-grid--wide" data-items>
			{posts.map((p, i) => <ArticleCard item={p} index={i} />)}
		</div>
	</KitShell>
</MainGridLayout>
