---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PostPage from "../../components/PostPage.astro";

// 获取带有"程序系"标签的作品集文章
const portfolioArticles = await getCollection("portfolio", ({ data }) => {
	const isProd = import.meta.env.PROD;
	const isNotDraft = data.draft !== true;
	const hasProgrammingTag = data.tags?.includes("程序系");
	return isProd ? isNotDraft && hasProgrammingTag : hasProgrammingTag;
});

// 按发布日期降序排列（新的在上，旧的在下）
portfolioArticles.sort((a, b) => {
	return (
		new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
	);
});

// 构造与主页相同的 page 对象结构
const page = {
	data: portfolioArticles,
	url: {
		current: "/portfolio/programming",
		prev: undefined,
		next: undefined,
	},
	start: 0,
	end: portfolioArticles.length - 1,
	size: portfolioArticles.length,
	total: portfolioArticles.length,
	currentPage: 1,
	lastPage: 1,
};
---

<MainGridLayout banner={undefined} title="程序系">
    <PostPage page={page}></PostPage>
</MainGridLayout>

