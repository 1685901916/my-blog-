---
import { Icon } from "astro-icon/components";
import Cover from "../../../components/kit/Cover.astro";
import KitShell from "../../../components/kit/KitShell.astro";
import LibraryCard from "../../../components/kit/LibraryCard.astro";
import VaultNav from "../../../components/kit/VaultNav.astro";
import SideTags from "../../../components/kit/SideTags.astro";
import Markdown from "../../../components/misc/Markdown.astro";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
import { dayKey, getLibrary, type LibraryItem } from "../../../utils/kit/content";

export async function getStaticPaths() {
	const items = await getLibrary();
	return items.map((item) => ({
		params: { shelf: item.shelf.id, id: item.id },
		props: { item, siblings: items.filter((i) => i.shelf.id === item.shelf.id) },
	}));
}

const { item, siblings } = Astro.props as { item: LibraryItem; siblings: LibraryItem[] };
const { shelf } = item;
const { Content } = await item.entry.render();
const hasBody = (item.entry.body ?? "").trim().length > 0;
const wide = shelf.aspect !== "3 / 4";

// 相关条目：同书架里共享标签最多的几个
const related = siblings
	.filter((s) => s.id !== item.id)
	.map((s) => ({ s, score: s.tags.filter((t) => item.tags.includes(t)).length }))
	.filter((x) => x.score > 0)
	.sort((a, b) => b.score - a.score || (b.s.rating ?? 0) - (a.s.rating ?? 0))
	.slice(0, 6)
	.map((x) => x.s);

const dateText = item.date
	? `${dayKey(item.date)}${item.date.getUTCHours() || item.date.getUTCMinutes() ? ` ${item.date.toISOString().slice(11, 16)}` : ""}`
	: "";
const linkLabel = item.link?.includes("bgm.tv") ? "在 Bangumi 查看" : "访问";

const tagCount = new Map<string, number>();
for (const it of siblings) for (const t of it.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const shelfTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ name, count }));
---

<MainGridLayout title={item.title} description={`${shelf.title} · ${item.tags.join(" / ")}`}>
	<KitShell>
		<Fragment slot="side">
			<VaultNav active={`library:${shelf.id}`} />
			<SideTags
				id="kit-tags"
				title={`${shelf.title}的标签`}
				tags={shelfTags}
				mode="link"
				href={(t) => `/library/${shelf.id}/?tag=${encodeURIComponent(t)}`}
			/>
		</Fragment>

		<!-- data-pagefind-body：让站内搜索收录标题、评分和标签（没写短评的条目也能搜到） -->
		<article class:list={["card-base", "entry", "onload-animation", wide && "is-wide"]} data-pagefind-body>
			<div class="entry__cover" data-reveal>
				<Cover src={item.cover} title={item.title} aspect={shelf.aspect} eager />
			</div>
			<div class="entry__info">
				<nav class="kit-crumb text-50" aria-label="面包屑">
					<a href="/library/">收藏库</a><span class="opacity-50">/</span><a href={`/library/${shelf.id}/`}>{shelf.title}</a>
				</nav>
				<h1 class="kit-head__title text-90">
					<span data-split>{item.title}</span>
					{
						item.marks.map((m) => (
							<Icon class="kit-mark" name={m === "star" ? "material-symbols:star-rounded" : "material-symbols:favorite-rounded"} />
						))
					}
				</h1>

				<!-- 仿 Obsidian 属性面板 -->
				<dl class="props" data-reveal style="--i: 2">
					{
						typeof item.rating === "number" && (
							<div class="props__row">
								<dt class="text-50">
									<Icon name="material-symbols:star-rounded" />评分
								</dt>
								<dd class="props__rating">
									<b>{item.rating.toFixed(1)}</b>
									<span class="meter">
										<span style={`width: ${item.rating * 10}%`} />
									</span>
								</dd>
							</div>
						)
					}
					{
						item.tags.length > 0 && (
							<div class="props__row">
								<dt class="text-50">
									<Icon name="material-symbols:tag-rounded" />文件标签
								</dt>
								<dd class="flex flex-wrap gap-2">
									{item.tags.map((t) => (
										<a class="btn-regular h-6 text-xs px-2 rounded-lg" href={`/library/${shelf.id}/?tag=${encodeURIComponent(t)}`}>
											# {t}
										</a>
									))}
								</dd>
							</div>
						)
					}
					{
						dateText && (
							<div class="props__row">
								<dt class="text-50">
									<Icon name="material-symbols:calendar-today-outline-rounded" />date
								</dt>
								<dd class="text-75">{dateText}</dd>
							</div>
						)
					}
					{
						item.year && (
							<div class="props__row">
								<dt class="text-50">
									<Icon name="material-symbols:event-note-outline-rounded" />年份
								</dt>
								<dd class="text-75">{item.year}</dd>
							</div>
						)
					}
				</dl>

				{
					item.link && (
						<div class="mt-5" data-reveal style="--i: 4">
							<a class="kit-btn-solid" href={item.link} target="_blank" rel="noopener noreferrer">
								{linkLabel} <Icon name="material-symbols:open-in-new-rounded" />
							</a>
						</div>
					)
				}
			</div>
		</article>

		{
			hasBody && (
				<section class="card-base kit-section" data-reveal>
					<Markdown class="markdown-content">
						<Content />
					</Markdown>
				</section>
			)
		}

		{
			related.length > 0 && (
				<section data-reveal>
					<h2 class="kit-section-title text-90">
						标签相近 <small class="text-50">{related.length}</small>
					</h2>
					<div class:list={["kit-grid", wide && "kit-grid--wide"]}>
						{related.map((r, i) => <LibraryCard item={r} index={i} />)}
					</div>
				</section>
			)
		}
	</KitShell>
</MainGridLayout>

<style>
	.entry {
		display: grid;
		gap: 1.75rem;
		grid-template-columns: minmax(0, 1fr);
		padding: 1.5rem;
	}

	@media (min-width: 640px) {
		.entry {
			grid-template-columns: 12rem minmax(0, 1fr);
			padding: 1.75rem 2.25rem;
		}

		.entry.is-wide {
			grid-template-columns: 18rem minmax(0, 1fr);
		}
	}

	.entry__cover :global(.kit-cover) {
		border-radius: 0.75rem;
		box-shadow: var(--kit-shadow);
	}

	.props {
		margin-top: 1.25rem;
		display: flex;
		flex-direction: column;
	}

	.props__row {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
		padding: 0.65rem 0;
		border-top: 1px dashed rgb(0 0 0 / 0.1);
		font-size: 0.9375rem;
	}

	:global(:root.dark) .props__row {
		border-color: rgb(255 255 255 / 0.15);
	}

	.props__row dt {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.875rem;
	}

	.props__rating {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.props__rating b {
		font-family: var(--kit-num);
		font-size: 1.5rem;
		color: var(--primary);
	}

	.meter {
		flex: 1;
		max-width: 12rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--btn-regular-bg);
		overflow: hidden;
	}

	.meter span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--primary);
		transform-origin: left;
		animation: meter-in 1.1s var(--kit-ease-out) 0.3s both;
	}

	@keyframes meter-in {
		from {
			transform: scaleX(0);
		}
	}
</style>
