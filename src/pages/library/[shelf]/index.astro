---
import LibraryView from "../../../components/kit/LibraryView.astro";
import { shelves } from "../../../data/shelves";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";

export function getStaticPaths() {
	return shelves.map((shelf) => ({ params: { shelf: shelf.id }, props: { shelf } }));
}

const { shelf } = Astro.props;
---

<MainGridLayout title={`${shelf.title} · 收藏库`} description={shelf.description}>
	<LibraryView shelf={shelf} />
</MainGridLayout>
