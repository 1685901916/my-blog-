---
import { Icon } from "astro-icon/components";
import PageHero from "../../components/kit/PageHero.astro";
import ShelfTabs from "../../components/kit/ShelfTabs.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getShelvesWithItems } from "../../utils/kit/content";

const shelvesWithItems = await getShelvesWithItems();
const total = shelvesWithItems.reduce((n, s) => n + s.items.length, 0);
const allTitles = shelvesWithItems.flatMap((s) => s.items.map((i) => i.title));
const half = Math.ceil(allTitles.length / 2);
---

<MainGridLayout title="收藏库" description="看过的番、常用的站，一条笔记一张卡片">
	<div class="kit">
		<PageHero
			eyebrow="LIBRARY · 收藏库"
			title="收藏库"
			subtitle="和 Obsidian 的数据库一样：一条笔记就是一张卡片，可以按评分、日期、标签随便翻。"
			kinetic={[allTitles.slice(0, half), allTitles.slice(half), ["LIBRARY", "收藏库", "BASES"]]}
		>
			<span><b>{total}</b>个条目</span>
			<span><b>{shelvesWithItems.length}</b>个书架</span>
		</PageHero>

		<div data-reveal style="--i: 1"><ShelfTabs /></div>

		{
			shelvesWithItems.map(({ shelf, items }, i) => {
				const covers = items.filter((it) => it.cover).slice(0, 5);
				return (
					<a href={`/library/${shelf.id}/`} class="kit-panel shelf" data-reveal style={`--i: ${i + 2}`}>
						<div class="shelf__info">
							<div class="kit-eyebrow">
								<Icon name={shelf.icon} class="inline -translate-y-px" /> {shelf.id.toUpperCase()}
							</div>
							<h2 class="shelf__title">{shelf.title}</h2>
							<p class="kit-subtitle">{shelf.description}</p>
							<div class="shelf__meta">
								<span class="kit-chip">{items.length} 个条目</span>
								<span class="kit-btn">
									打开书架 <Icon name="material-symbols:arrow-forward-rounded" />
								</span>
							</div>
						</div>
						<div class:list={["shelf__fan", shelf.aspect !== "3 / 4" && "is-wide"]} aria-hidden="true">
							{covers.map((c, ci) => (
								<img
									src={c.cover}
									alt=""
									loading="lazy"
									referrerpolicy="no-referrer"
									style={`--k: ${ci - (covers.length - 1) / 2}; z-index: ${10 - Math.abs(ci - Math.floor(covers.length / 2))}`}
								/>
							))}
						</div>
					</a>
				);
			})
		}
	</div>
</MainGridLayout>

<style>
	.shelf {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		align-items: center;
		color: inherit;
	}

	@media (min-width: 768px) {
		.shelf {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		}
	}

	.shelf__title {
		font-size: 1.75rem;
		font-weight: 800;
		color: var(--kit-ink);
	}

	.shelf__meta {
		margin-top: 1.25rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	/* 扇形叠放的封面：悬停时散开，用弹簧曲线 */
	.shelf__fan {
		position: relative;
		height: 13rem;
	}

	.shelf__fan img {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: 7.5rem;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 0.75rem;
		border: 3px solid var(--card-bg);
		box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.45);
		transform-origin: 50% 120%;
		transform: translateX(calc(-50% + var(--k) * 2.6rem)) rotate(calc(var(--k) * 5deg));
		transition: transform 0.7s var(--kit-spring);
	}

	.shelf__fan.is-wide img {
		width: 12rem;
		aspect-ratio: 16 / 10;
		transform-origin: 50% 200%;
		transform: translateX(calc(-50% + var(--k) * 2.2rem)) rotate(calc(var(--k) * 3deg));
	}

	.shelf:hover .shelf__fan img {
		transform: translateX(calc(-50% + var(--k) * 4.4rem)) translateY(-0.5rem) rotate(calc(var(--k) * 9deg));
	}

	.shelf:hover .shelf__fan.is-wide img {
		transform: translateX(calc(-50% + var(--k) * 3.6rem)) translateY(-0.5rem) rotate(calc(var(--k) * 6deg));
	}

	@media (prefers-reduced-motion: reduce) {
		.shelf__fan img {
			transition: none;
		}
	}
</style>
