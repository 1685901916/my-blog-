---
// 方案 C 的文章阅读页（B站专栏式）：浅灰底，左边白色正文卡片，右边作者卡片 + 目录
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "../../../components/LightDarkSwitch.svelte";
import ImageWrapper from "../../../components/misc/ImageWrapper.astro";
import Markdown from "../../../components/misc/Markdown.astro";
import PreviewSwitch from "../../../components/preview/PreviewSwitch.astro";
import { cnDate, getProtoArticlePaths, type ProtoArticle } from "../../../components/preview/proto";
import { profileConfig, siteConfig } from "../../../config";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
	return getProtoArticlePaths("c");
}

const { entry, kind, prev, next } = Astro.props as ProtoArticle;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const toc = headings.filter((h) => h.depth <= Math.min(...headings.map((x) => x.depth)) + 1);
const category = kind === "work" ? "作品" : entry.data.category || "文章";
const minutes = remarkPluginFrontmatter?.minutes as number | undefined;
const words = remarkPluginFrontmatter?.words as number | undefined;
const tags = entry.data.tags.filter((t) => t !== entry.data.category);
---

<Layout title={entry.data.title} description={entry.data.description}>
	<div class="rc" data-no-swup>
		<header class="bar">
			<div class="bar__inner">
				<a href="/preview/c/" class="bar__logo"><span class="bar__mark">文</span>{siteConfig.title}</a>
				<LightDarkSwitch client:only="svelte" />
				<a href="/about/" class="bar__avatar" aria-label="关于我"><ImageWrapper src={profileConfig.avatar || ""} alt="" class="w-full h-full" /></a>
			</div>
		</header>

		<div class="wrap">
			<article class="paper">
				<a href="/preview/c/" class="back"><Icon name="material-symbols:arrow-back-rounded" />返回空间</a>
				<span class="cat">{category}</span>
				<h1 class="title">{entry.data.title}</h1>
				<div class="author">
					<span class="author__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt="" class="w-full h-full" /></span>
					<div>
						<div class="author__name">{profileConfig.name}</div>
						<div class="author__meta">
							<time>{cnDate(entry.data.published)}</time>
							{words && <span>{words} 字</span>}
							{minutes && <span>约 {minutes} 分钟</span>}
						</div>
					</div>
				</div>
				{entry.data.description && <p class="lead">{entry.data.description}</p>}
				{entry.data.image && <img class="cover" src={entry.data.image} alt="" referrerpolicy="no-referrer" />}

				<Markdown class="markdown-content body">
					<Content />
				</Markdown>

				{
					tags.length > 0 && (
						<div class="tags">
							{tags.map((t) => (
								<a href={`/posts/?tag=${encodeURIComponent(t)}`}>{t}</a>
							))}
						</div>
					)
				}
			</article>

			<aside class="aside">
				<section class="panel me">
					<div class="me__head">
						<span class="me__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt="" class="w-full h-full" /></span>
						<div>
							<div class="me__name">{profileConfig.name}</div>
							<div class="me__sub">{siteConfig.title}</div>
						</div>
					</div>
					<p class="me__bio">{profileConfig.bio}</p>
				</section>

				{
					toc.length > 1 && (
						<section class="panel">
							<h3 class="panel__title">目录</h3>
							<nav data-toc>
								{toc.map((h) => (
									<a href={`#${h.slug}`} class:list={["kit-toc__link", h.depth > toc[0].depth && "is-sub"]} data-toc-target={h.slug}>
										{h.text.replace(/#$/, "")}
									</a>
								))}
							</nav>
						</section>
					)
				}

				<section class="panel pager">
					{prev && <a href={prev.href}><small>上一篇</small><span>{prev.title}</span></a>}
					{next && <a href={next.href}><small>下一篇</small><span>{next.title}</span></a>}
				</section>
			</aside>
		</div>
	</div>
	<PreviewSwitch current="c" />
</Layout>

<style>
	.rc {
		--c-bg: color-mix(in oklch, var(--card-bg) 95%, black);
		--c-card: var(--card-bg);
		--c-text: rgb(24 25 28);
		--c-soft: rgb(97 102 109);
		--c-muted: rgb(148 153 160);
		--c-line: color-mix(in oklch, var(--card-bg) 92%, black);
		min-height: 100vh;
		background: var(--c-bg);
		color: var(--c-text);
	}

	:global(:root.dark) .rc {
		--c-bg: color-mix(in oklch, var(--card-bg) 80%, black);
		--c-text: rgb(232 232 232);
		--c-soft: rgb(190 190 195);
		--c-muted: rgb(150 150 150);
		--c-line: color-mix(in oklch, var(--card-bg) 88%, white);
	}

	.bar {
		position: sticky;
		top: 0;
		z-index: 30;
		background: var(--c-card);
		box-shadow: 0 1px 0 var(--c-line);
	}

	.bar__inner {
		max-width: 72rem;
		margin: 0 auto;
		height: 3.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0 1.5rem;
	}

	.bar__inner > :global(:nth-child(2)) {
		margin-left: auto;
	}

	.bar__logo {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 800;
	}

	.bar__mark {
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.9rem;
		color: white;
		background: var(--primary);
	}

	.bar__avatar {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 999px;
		overflow: hidden;
	}

	.wrap {
		max-width: 72rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem 5rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 18rem;
		gap: 1rem;
		align-items: start;
	}

	.paper {
		background: var(--c-card);
		border-radius: 0.9rem;
		padding: 2rem clamp(1.25rem, 4vw, 3.5rem) 3rem;
		min-width: 0;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.82rem;
		color: var(--c-muted);
	}

	.back:hover {
		color: var(--primary);
	}

	.cat {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.15rem 0.55rem;
		border-radius: 0.35rem;
		font-size: 0.78rem;
		color: var(--primary);
		background: color-mix(in oklch, var(--card-bg) 88%, var(--primary));
	}

	.title {
		margin-top: 0.7rem;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 900;
		line-height: 1.35;
	}

	.author {
		margin-top: 1.25rem;
		padding-bottom: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		border-bottom: 1px solid var(--c-line);
	}

	.author__avatar {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		overflow: hidden;
	}

	.author__name {
		font-weight: 700;
		font-size: 0.92rem;
	}

	.author__meta {
		display: flex;
		gap: 0.75rem;
		font-size: 0.78rem;
		color: var(--c-muted);
	}

	.lead {
		margin-top: 1.5rem;
		padding: 0.9rem 1.1rem;
		border-radius: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.8;
		color: var(--c-soft);
		background: var(--c-bg);
	}

	.cover {
		margin-top: 1.5rem;
		width: 100%;
		max-height: 24rem;
		object-fit: cover;
		border-radius: 0.75rem;
	}

	.paper :global(.body) {
		margin-top: 1.75rem;
	}

	.tags {
		margin-top: 2.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tags a {
		padding: 0.3rem 0.75rem;
		border-radius: 0.4rem;
		font-size: 0.8rem;
		background: var(--c-bg);
		color: var(--c-soft);
	}

	.tags a:hover {
		color: var(--primary);
	}

	.aside {
		position: sticky;
		top: 4.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.panel {
		background: var(--c-card);
		border-radius: 0.9rem;
		padding: 1.1rem 1.25rem;
	}

	.panel__title {
		margin-bottom: 0.6rem;
		font-size: 0.95rem;
		font-weight: 800;
	}

	.me__head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.me__avatar {
		width: 3rem;
		height: 3rem;
		border-radius: 999px;
		overflow: hidden;
	}

	.me__name {
		font-weight: 800;
	}

	.me__sub {
		font-size: 0.78rem;
		color: var(--c-muted);
	}

	.me__bio {
		margin-top: 0.8rem;
		font-size: 0.84rem;
		line-height: 1.75;
		color: var(--c-soft);
	}

	.pager {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.pager small {
		font-size: 0.72rem;
		color: var(--c-muted);
	}

	.pager span {
		font-size: 0.875rem;
		font-weight: 700;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.pager a:hover span {
		color: var(--primary);
	}

	@media (max-width: 1024px) {
		.wrap {
			grid-template-columns: minmax(0, 1fr);
		}

		.aside {
			position: static;
		}
	}

	@media (max-width: 640px) {
		.wrap {
			padding: 0.75rem 0.75rem 5rem;
		}
	}
</style>
