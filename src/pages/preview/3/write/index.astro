---
// 方案 3 的「写作」页（Pixiv 小说列表式）：文章 / 随笔 / 月记 / 作品，两列卡片 = 封面 + 标题 + 摘要 + 标签 + 字数
// 文章、月记、作品点进去是 B 方案的阅读页；随笔（Obsidian 里 0/1 开头的笔记）点进去是方案 3 的条目页
import { Icon } from "astro-icon/components";
import P3Shell from "../../../../components/preview/p3/P3Shell.astro";
import { getAcg } from "../../../../components/preview/acg";
import { getProtoBase } from "../../../../components/preview/proto";

type Card = { kind: string; title: string; href: string; cover?: string; excerpt?: string; tags: string[]; words: number; date: string };
const countWords = (s = "") => (s.replace(/!\[[^\]]*\]\([^)]*\)|\]\([^)]*\)/g, "").match(/[一-鿿]|[A-Za-z0-9]+/g) ?? []).length;

const [rows, acg] = await Promise.all([getProtoBase("b"), getAcg()]);
const cards: Card[] = [
	...rows
		.filter((r) => r.kind !== "动漫")
		.map((r) => ({
			kind: r.kind,
			title: r.title,
			href: r.href,
			cover: r.cover,
			excerpt: r.excerpt,
			tags: r.kind === "文章" ? [r.cat, ...r.tags] : r.tags,
			words: countWords(r.entry.body),
			date: r.date,
		})),
	...acg
		.filter((i) => i.essay)
		.map((i) => ({
			kind: "随笔",
			title: i.title,
			href: `/preview/3/i/${i.id}/`,
			cover: i.image || i.cover,
			excerpt: i.excerpt,
			tags: [i.section.name, ...i.tags],
			words: i.words,
			date: i.date,
		})),
].sort((a, b) => b.date.localeCompare(a.date));
const KINDS = ["文章", "随笔", "月记", "作品"];
---

<P3Shell title="方案 3 · 写作" tab="write">
	<section data-collection data-default-sort="date">
		<div class="bar">
			<div class="pills" role="group" aria-label="类型">
				<button type="button" data-filter-cat="" aria-pressed="true">全部 <small>{cards.length}</small></button>
				{
					KINDS.map((k) => (
						<button type="button" data-filter-cat={k} aria-pressed="false">
							{k} <small>{cards.filter((c) => c.kind === k).length}</small>
						</button>
					))
				}
			</div>
		</div>

		<div class="list" data-items>
			{
				cards.map((c, n) => (
					<div data-item data-title={c.title} data-cat={c.kind} data-tags={c.tags.join("|")} data-date={c.date} data-reveal style={`--i: ${Math.min(n, 10)}`}>
						<a href={c.href} class="novel">
							<div class:list={["novel__cover", !c.cover && "is-empty"]}>
								{c.cover ? <img src={c.cover} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span>{c.title}</span>}
							</div>
							<div class="novel__body">
								<div class="novel__kind">{c.kind}</div>
								<h2 class="novel__title">{c.title}</h2>
								{c.excerpt && <p class="novel__excerpt">{c.excerpt}</p>}
								<div class="novel__tags">
									{c.tags.filter(Boolean).slice(0, 4).map((t) => (
										<span>#{t}</span>
									))}
								</div>
								<div class="novel__meta">
									<span><Icon name="material-symbols:notes-rounded" />{c.words} 字</span>
									<span><Icon name="material-symbols:schedule-outline-rounded" />约 {Math.max(1, Math.round(c.words / 400))} 分钟</span>
									<span>{c.date}</span>
								</div>
							</div>
						</a>
					</div>
				))
			}
		</div>
	</section>
</P3Shell>

<style>
	.bar {
		margin-bottom: 1.25rem;
	}

	.pills {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.pills button {
		height: 2.1rem;
		padding: 0 1rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--x-soft);
		background: var(--x-soft-bg);
	}

	.pills small {
		font-family: var(--kit-num);
		font-weight: 500;
		opacity: 0.6;
	}

	.pills button[aria-pressed="true"] {
		color: var(--x-bg);
		background: var(--x-text);
	}

	.list {
		max-width: 72rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 1.5rem;
	}

	.novel {
		display: flex;
		gap: 1.1rem;
		height: 100%;
		padding: 1rem;
		border-radius: 0.75rem;
		transition: background 0.15s;
	}

	.novel:hover {
		background: var(--x-soft-bg);
	}

	.novel__cover {
		width: 7.5rem;
		aspect-ratio: 3 / 4;
		flex: none;
		overflow: hidden;
		border-radius: 0.4rem;
		background: var(--x-soft-bg);
		box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.5);
	}

	.novel__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	.novel__cover.is-empty {
		display: flex;
		align-items: flex-end;
		padding: 0.6rem;
		background: linear-gradient(160deg, color-mix(in oklch, var(--x-blue) 18%, var(--x-bg)), color-mix(in oklch, var(--x-blue) 40%, var(--x-bg)));
	}

	.novel__cover.is-empty span {
		font-size: 0.85rem;
		font-weight: 900;
		line-height: 1.35;
	}

	.novel__body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.novel__kind {
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--x-muted);
	}

	.novel__title {
		font-size: 1.05rem;
		font-weight: 900;
		line-height: 1.4;
	}

	.novel:hover .novel__title {
		text-decoration: underline;
	}

	.novel__excerpt {
		font-size: 0.82rem;
		line-height: 1.7;
		color: var(--x-soft);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.novel__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 0.6rem;
		font-size: 0.78rem;
		color: var(--x-blue);
	}

	.novel__meta {
		margin-top: auto;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		font-size: 0.75rem;
		color: var(--x-muted);
	}

	.novel__meta span {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
	}

	@media (max-width: 800px) {
		.list {
			grid-template-columns: minmax(0, 1fr);
		}

		.novel__cover {
			width: 5.5rem;
		}
	}
</style>
