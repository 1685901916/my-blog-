---
// 方案 B · 个人主页式（像 folia 官网）：首屏插画 + 大标题 + 介绍，下面一排分类标签，内容满宽，没有侧栏
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "../../components/LightDarkSwitch.svelte";
import Cover from "../../components/kit/Cover.astro";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PreviewSwitch from "../../components/preview/PreviewSwitch.astro";
import { profileConfig, siteConfig } from "../../config";
import Layout from "../../layouts/Layout.astro";
import { dayKey, getFeed, getLibrary, getMonthDigests } from "../../utils/kit/content";

const [feed, library, digests] = await Promise.all([getFeed(), getLibrary(), getMonthDigests()]);
const posts = feed.filter((f) => f.kind === "post");
const works = feed.filter((f) => f.kind === "work");
const anime = library.filter((i) => i.shelf.id === "anime").sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0));
const sites = library.filter((i) => i.shelf.id === "sites");
const banner = "/assets/desktop-banner/custom-bg.jpg";
const host = (u?: string) => (u ? new URL(u).hostname.replace(/^www\./, "") : "");
const tabs = [
	{ id: "all", label: "全部" },
	{ id: "posts", label: "文章", count: posts.length },
	{ id: "anime", label: "动漫", count: anime.length },
	{ id: "works", label: "作品", count: works.length },
	{ id: "sites", label: "资源站", count: sites.length },
	{ id: "journal", label: "月记", count: digests.length },
];
---

<Layout title="方案 B · 个人主页式">
	<div class="pb" data-no-swup>
		<!-- 顶栏：透明压在插画上 -->
		<header class="nav">
			<a href="/preview/b/" class="nav__logo">{siteConfig.title}</a>
			<nav class="nav__links">
				<a href="/posts/">文章</a>
				<a href="/library/">收藏库</a>
				<a href="/works/">作品</a>
				<a href="/journal/">月记</a>
				<a href="/about/">关于</a>
			</nav>
			<div class="nav__theme"><LightDarkSwitch client:only="svelte" /></div>
		</header>

		<!-- 首屏：插画 + 头像 + 大标题 + 介绍 -->
		<section class="hero">
			<img class="hero__bg" src={banner} alt="" />
			<div class="hero__shade" />
			<div class="hero__inner">
				<div class="hero__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
				<h1 class="hero__title" data-split>{siteConfig.title}</h1>
				<p class="hero__sub">{profileConfig.name} · {siteConfig.subtitle}</p>
				<p class="hero__bio">{profileConfig.bio}</p>
				<div class="hero__actions">
					<a href="#content" class="hero__btn hero__btn--solid">逛逛库里 <Icon name="material-symbols:arrow-downward-rounded" /></a>
					{profileConfig.links.map((l) => (
						<a href={l.url} target="_blank" rel="noopener noreferrer" class="hero__btn"><Icon name={l.icon} />{l.name}</a>
					))}
				</div>
				<dl class="hero__stats">
					<div><dd>{posts.length}</dd><dt>文章</dt></div>
					<div><dd>{anime.length}</dd><dt>番剧</dt></div>
					<div><dd>{works.length}</dd><dt>作品</dt></div>
					<div><dd>{digests.filter((d) => d.note).length}</dd><dt>月记</dt></div>
				</dl>
			</div>
		</section>

		<!-- 分类标签：吸顶 -->
		<nav class="tabs" id="content" aria-label="分类">
			<div class="tabs__inner">
				{tabs.map((t, i) => (
					<button type="button" class:list={["tabs__item", i === 0 && "is-on"]} data-b-tab={t.id}>
						{t.label}
						{t.count !== undefined && <small>{t.count}</small>}
					</button>
				))}
			</div>
		</nav>

		<main class="content">
			<section class="block" data-b-block="posts" data-reveal>
				<h2 class="block__title">文章 <a href="/posts/">全部 <Icon name="material-symbols:arrow-forward-rounded" /></a></h2>
				<div class="posts">
					{posts.map((p) => (
						<a href={p.url} class="post">
							<div class="post__thumb">{p.cover ? <img src={p.cover} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span>{[...p.title][0]}</span>}</div>
							<div class="post__text">
								<div class="post__meta"><b>{p.category}</b>{dayKey(p.date)}</div>
								<div class="post__title">{p.title}</div>
								<div class="post__desc">{p.description}</div>
							</div>
						</a>
					))}
				</div>
			</section>

			<section class="block" data-b-block="anime" data-reveal>
				<h2 class="block__title">动漫 <a href="/library/anime/">打开书架 <Icon name="material-symbols:arrow-forward-rounded" /></a></h2>
				<div class="posters">
					{anime.map((a) => (
						<a href={a.url} class="poster">
							<Cover src={a.cover} title={a.title} aspect="3 / 4">
								{typeof a.rating === "number" && <span class="kit-rating"><Icon name="material-symbols:star-rounded" />{a.rating.toFixed(1)}</span>}
							</Cover>
							<span class="poster__title">{a.title}</span>
							<span class="poster__tags">{a.tags.slice(0, 2).join(" · ")}</span>
						</a>
					))}
				</div>
			</section>

			<section class="block" data-b-block="works" data-reveal>
				<h2 class="block__title">作品 <a href="/works/">作品墙 <Icon name="material-symbols:arrow-forward-rounded" /></a></h2>
				<div class="works">
					{works.map((w) => (
						<a href={w.url} class="work">
							<Cover src={w.cover} title={w.title} aspect="16 / 10" />
							<div class="work__title">{w.title}</div>
							<div class="work__desc">{w.description}</div>
						</a>
					))}
				</div>
			</section>

			<section class="block" data-b-block="sites" data-reveal>
				<h2 class="block__title">资源站 <a href="/library/sites/">全部 <Icon name="material-symbols:arrow-forward-rounded" /></a></h2>
				<div class="sites">
					{sites.map((s) => (
						<a href={s.url} class="site">
							<span class="site__mark">{[...s.title][0]}</span>
							<span class="site__name">{s.title}</span>
							<span class="site__host">{host(s.link)}</span>
						</a>
					))}
				</div>
			</section>

			<section class="block" data-b-block="journal" data-reveal>
				<h2 class="block__title">月记 <a href="/journal/">全部月份 <Icon name="material-symbols:arrow-forward-rounded" /></a></h2>
				<div class="months">
					{digests.map((d) => (
						<a href={`/journal/${d.month}/`} class:list={["month", d.note && "is-note"]}>
							<span class="month__n">{String(d.monthNumber).padStart(2, "0")}</span>
							<span class="month__y">{d.year}</span>
						</a>
					))}
				</div>
			</section>
		</main>

		<footer class="foot">© {new Date().getFullYear()} {profileConfig.name} · {siteConfig.title}</footer>
	</div>
	<PreviewSwitch current="b" />
</Layout>

<script>
	// 分类标签：「全部」显示所有分区，其余只显示对应分区（原型演示用）
	const root = document.querySelector<HTMLElement>(".pb");
	if (root) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-b-tab]")];
		const blocks = [...root.querySelectorAll<HTMLElement>("[data-b-block]")];
		for (const t of tabs) {
			t.addEventListener("click", () => {
				for (const x of tabs) x.classList.toggle("is-on", x === t);
				const id = t.dataset.bTab;
				for (const b of blocks) b.hidden = id !== "all" && b.dataset.bBlock !== id;
				root.querySelector("#content")?.scrollIntoView({ behavior: "smooth", block: "start" });
			});
		}
	}
</script>

<style>
	.pb {
		--b-text: rgb(30 30 30);
		--b-muted: rgb(125 125 125);
		--b-line: color-mix(in oklch, var(--card-bg) 88%, black);
		background: var(--card-bg);
		color: var(--b-text);
		min-height: 100vh;
	}

	:global(:root.dark) .pb {
		--b-text: rgb(238 238 238);
		--b-muted: rgb(150 150 150);
		--b-line: color-mix(in oklch, var(--card-bg) 84%, white);
	}

	/* 顶栏 */
	.nav {
		position: absolute;
		z-index: 10;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.25rem clamp(1.25rem, 5vw, 4rem);
		color: white;
	}

	.nav__logo {
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: 0.04em;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.25);
	}

	.nav__links {
		display: flex;
		gap: 1.5rem;
		margin-left: auto;
		font-size: 0.92rem;
		font-weight: 600;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.25);
	}

	.nav__links a {
		opacity: 0.9;
	}

	.nav__links a:hover {
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: 6px;
	}

	.nav__theme :global(button) {
		color: white;
	}

	/* 首屏 */
	.hero {
		position: relative;
		min-height: min(92vh, 56rem);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		z-index: -2;
		transform: scale(1.04);
	}

	.hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(to bottom, rgb(0 0 0 / 0.25), rgb(0 0 0 / 0.05) 40%, transparent 60%),
			linear-gradient(to top, var(--card-bg) 0%, color-mix(in oklch, var(--card-bg) 70%, transparent) 25%, transparent 55%);
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 6rem 1.5rem 3rem;
		max-width: 46rem;
	}

	.hero__avatar {
		width: 6.5rem;
		height: 6.5rem;
		border-radius: 999px;
		overflow: hidden;
		border: 4px solid white;
		box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.5);
	}

	.hero__title {
		margin-top: 1.25rem;
		font-size: clamp(2.75rem, 7vw, 5rem);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: 0.04em;
		color: white;
		text-shadow: 0 4px 30px rgb(0 0 0 / 0.35);
	}

	.hero__sub {
		margin-top: 0.75rem;
		font-size: 1.05rem;
		font-weight: 600;
		color: white;
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.35);
	}

	.hero__bio {
		margin-top: 1.25rem;
		padding: 0.9rem 1.25rem;
		border-radius: 1rem;
		font-size: 0.95rem;
		line-height: 1.8;
		color: var(--b-text);
		background: color-mix(in oklch, var(--card-bg) 82%, transparent);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
	}

	.hero__actions {
		margin-top: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
	}

	.hero__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.75rem;
		padding: 0 1.25rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.92rem;
		color: var(--b-text);
		background: color-mix(in oklch, var(--card-bg) 85%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		transition: transform 0.35s var(--kit-spring);
	}

	.hero__btn:hover {
		transform: translateY(-2px);
	}

	.hero__btn--solid {
		color: white;
		background: rgb(25 25 25);
	}

	.hero__stats {
		margin-top: 2rem;
		display: flex;
		gap: 2.5rem;
	}

	.hero__stats div {
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
	}

	.hero__stats dd {
		font-family: var(--kit-num);
		font-size: 1.75rem;
		font-weight: 800;
	}

	.hero__stats dt {
		font-size: 0.8rem;
		color: var(--b-muted);
	}

	/* 分类标签 */
	.tabs {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in oklch, var(--card-bg) 90%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--b-line);
		scroll-margin-top: 0;
	}

	.tabs__inner {
		max-width: 76rem;
		margin: 0 auto;
		display: flex;
		gap: 0.25rem;
		padding: 0.6rem clamp(1rem, 4vw, 2rem);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.tabs__item {
		flex: none;
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--b-muted);
		transition:
			background 0.2s,
			color 0.2s;
	}

	.tabs__item small {
		font-family: var(--kit-num);
		font-size: 0.75rem;
		font-weight: 500;
	}

	.tabs__item:hover {
		color: var(--b-text);
	}

	.tabs__item.is-on {
		background: var(--b-text);
		color: var(--card-bg);
	}

	/* 内容 */
	.content {
		max-width: 76rem;
		margin: 0 auto;
		padding: 2.5rem clamp(1rem, 4vw, 2rem) 4rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.block__title {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
		font-size: 1.6rem;
		font-weight: 900;
		letter-spacing: 0.03em;
	}

	.block__title a {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--b-muted);
	}

	.block__title a:hover {
		color: var(--primary);
	}

	.posts {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
		gap: 0.5rem 2rem;
	}

	.post {
		display: flex;
		gap: 1rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--b-line);
	}

	.post__thumb {
		flex: none;
		width: 6.5rem;
		aspect-ratio: 4 / 3;
		border-radius: 0.6rem;
		overflow: hidden;
		background: color-mix(in oklch, var(--card-bg) 92%, black);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 900;
		font-size: 1.5rem;
		color: var(--b-muted);
	}

	.post__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post__text {
		min-width: 0;
	}

	.post__meta {
		display: flex;
		gap: 0.6rem;
		font-size: 0.75rem;
		color: var(--b-muted);
		font-family: var(--kit-num);
	}

	.post__meta b {
		color: var(--primary);
		font-weight: 700;
	}

	.post__title {
		margin-top: 0.2rem;
		font-weight: 800;
		font-size: 1.02rem;
		transition: color 0.15s;
	}

	.post:hover .post__title {
		color: var(--primary);
	}

	.post__desc {
		margin-top: 0.25rem;
		font-size: 0.85rem;
		color: var(--b-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.posters {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 1.5rem 1.1rem;
	}

	.poster {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.poster :global(.kit-cover) {
		border-radius: 0.9rem;
		transition:
			transform 0.5s var(--kit-spring),
			box-shadow 0.4s;
	}

	.poster:hover :global(.kit-cover) {
		transform: translateY(-5px) rotate(-0.6deg);
		box-shadow: 0 22px 40px -22px rgb(0 0 0 / 0.55);
	}

	.poster__title {
		margin-top: 0.3rem;
		font-weight: 800;
		font-size: 0.92rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.poster__tags {
		font-size: 0.75rem;
		color: var(--b-muted);
	}

	.works {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1.75rem 1.5rem;
	}

	.work :global(.kit-cover) {
		border-radius: 1rem;
		border: 1px solid var(--b-line);
		transition: transform 0.5s var(--kit-spring);
	}

	.work:hover :global(.kit-cover) {
		transform: translateY(-4px);
	}

	.work__title {
		margin-top: 0.85rem;
		font-weight: 800;
		font-size: 1.1rem;
	}

	.work__desc {
		margin-top: 0.3rem;
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--b-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.sites {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.75rem;
	}

	.site {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.8rem 1rem;
		border-radius: 0.9rem;
		border: 1px solid var(--b-line);
		transition: border-color 0.15s;
	}

	.site:hover {
		border-color: var(--primary);
	}

	.site__mark {
		flex: none;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 900;
		color: var(--primary);
		background: color-mix(in oklch, var(--card-bg) 86%, var(--primary));
	}

	.site__name {
		font-weight: 800;
		font-size: 0.92rem;
	}

	.site__host {
		margin-left: auto;
		font-size: 0.75rem;
		color: var(--b-muted);
	}

	.months {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
		gap: 0.75rem;
	}

	.month {
		display: flex;
		flex-direction: column;
		padding: 1rem;
		border-radius: 1rem;
		background: color-mix(in oklch, var(--card-bg) 94%, black);
	}

	.month.is-note {
		background: color-mix(in oklch, var(--card-bg) 82%, var(--primary));
	}

	.month__n {
		font-family: var(--kit-num);
		font-size: 2rem;
		font-weight: 800;
		line-height: 1;
	}

	.month.is-note .month__n {
		color: var(--primary);
	}

	.month__y {
		margin-top: 0.3rem;
		font-size: 0.75rem;
		color: var(--b-muted);
	}

	.foot {
		padding: 2rem 1rem 5rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--b-muted);
		border-top: 1px solid var(--b-line);
	}

	@media (max-width: 760px) {
		.nav__links {
			display: none;
		}

		.nav__theme {
			margin-left: auto;
		}

		.hero__stats {
			gap: 1.5rem;
		}

		.posts {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
