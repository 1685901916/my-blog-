---
// 方案 1 的分区页（Bangumi 式）：左边 子分类标签 + 排序 + 海报墙，右边 分区统计 / 标签 / 随笔
// 筛选、排序交给 kit.ts 的卡片引擎：子分类 = data-cat，标签 = data-tags
import { Icon } from "astro-icon/components";
import Entry from "../../../components/preview/p1/Entry.astro";
import P1Shell from "../../../components/preview/p1/P1Shell.astro";
import { getSectionData, SECTIONS } from "../../../components/preview/acg";

export function getStaticPaths() {
	return SECTIONS.map((s) => ({ params: { section: s.key } }));
}

const { section } = Astro.params;
const { section: sec, items, essays, subs, tags } = await getSectionData(section as string);
const hearts = items.filter((i) => i.marks.includes("heart")).length;
const stars = items.filter((i) => i.marks.includes("star")).length;
const words = items.reduce((n, i) => n + i.words, 0);
const rated = items.filter((i) => typeof i.rating === "number");
const avg = rated.length ? rated.reduce((n, i) => n + (i.rating ?? 0), 0) / rated.length : 0;
const cols = sec.kind === "work" ? 6 : sec.kind === "person" ? 6 : 2;
---

<P1Shell title={`${sec.name} · 方案 1`} current={sec.key}>
	<nav class="crumbs"><a href="/preview/1/">首页</a><span>›</span>{sec.name}</nav>

	<div class="page" data-collection data-default-sort="rating">
		<div class="main">
			<header class="head">
				<h1><Icon name={sec.icon} />{sec.name}<small>{items.length} 个条目</small></h1>
				<label class="sort">
					<Icon name="material-symbols:swap-vert-rounded" />
					<select data-sort aria-label="排序">
						<option value="rating" selected>喜欢 / 评分优先</option>
						<option value="date">最近更新</option>
						<option value="title">按名字</option>
					</select>
				</label>
			</header>

			{
				subs.length > 0 && (
					<div class="subs" role="group" aria-label="子分类">
						<button type="button" data-filter-cat="" aria-pressed="true">
							全部<small>{items.length}</small>
						</button>
						{subs.map(([s, n]) => (
							<button type="button" data-filter-cat={s} aria-pressed="false">
								{s}
								<small>{n}</small>
							</button>
						))}
					</div>
				)
			}

			<div class="kit-grid grid" data-items style={`--cols: ${cols}`}>
				{items.map((i, n) => <Entry item={i} engine index={n} />)}
			</div>
		</div>

		<aside class="side">
			<section class="box">
				<h3>{sec.name}统计</h3>
				<dl class="stats">
					<div><dt>条目</dt><dd>{items.length}</dd></div>
					<div><dt>喜欢</dt><dd>{hearts}</dd></div>
					<div><dt>推荐</dt><dd>{stars}</dd></div>
					{avg > 0 ? <div><dt>平均分</dt><dd>{avg.toFixed(1)}</dd></div> : <div><dt>字数</dt><dd>{(words / 1000).toFixed(1)}k</dd></div>}
				</dl>
			</section>

			{
				tags.length > 0 && (
					<section class="box">
						<h3>标签</h3>
						<div class="cloud">
							{tags.slice(0, 30).map(([t, n]) => (
								<button type="button" data-filter={t} aria-pressed="false">
									{t}
									<small>{n}</small>
								</button>
							))}
						</div>
					</section>
				)
			}

			{
				essays.length > 0 && (
					<section class="box">
						<h3>随笔</h3>
						<ul class="essays">
							{essays.map((i) => (
								<li>
									<a href={`/preview/1/i/${i.id}/`}>
										<b>{i.title}</b>
										<span>{i.excerpt}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<section class="box">
				<h3>其他分区</h3>
				<div class="others">
					{SECTIONS.filter((s) => s.key !== sec.key).map((s) => (
						<a href={`/preview/1/${s.key}/`}>
							<Icon name={s.icon} />
							{s.name}
						</a>
					))}
				</div>
			</section>
		</aside>
	</div>
</P1Shell>

<style>
	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--p1-muted);
	}

	.crumbs a:hover {
		color: var(--primary);
	}

	.page {
		margin-top: 0.9rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 17rem;
		gap: 1.75rem;
		align-items: start;
	}

	.head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--p1-line);
	}

	.head h1 {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 1.5rem;
		font-weight: 900;
	}

	.head h1 :global(svg) {
		color: var(--primary);
	}

	.head h1 small {
		margin-left: 0.25rem;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--p1-muted);
	}

	.sort {
		position: relative;
		display: flex;
		align-items: center;
	}

	.sort :global(svg) {
		position: absolute;
		left: 0.55rem;
		color: var(--p1-muted);
		pointer-events: none;
	}

	.sort select {
		height: 2rem;
		padding: 0 0.75rem 0 1.8rem;
		border-radius: 0.5rem;
		font-size: 0.82rem;
		color: inherit;
		background: var(--p1-card);
		border: 1px solid var(--p1-line);
		outline: none;
	}

	.subs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1rem;
	}

	.subs button {
		height: 1.9rem;
		padding: 0 0.8rem;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--p1-soft);
		background: var(--p1-card);
		border: 1px solid var(--p1-line);
		transition:
			color 0.15s,
			background 0.15s;
	}

	.subs small,
	.cloud small {
		margin-left: 0.3rem;
		font-family: var(--kit-num);
		font-size: 0.7rem;
		opacity: 0.6;
	}

	.subs button:hover {
		color: var(--primary);
	}

	.subs button[aria-pressed="true"] {
		color: white;
		background: var(--primary);
		border-color: var(--primary);
	}

	.grid {
		margin-top: 1.25rem;
		gap: 1.3rem 1rem;
	}

	.grid:not(.is-list) {
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
	}

	.side {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.box {
		padding: 1rem 1.1rem;
		border-radius: 0.8rem;
		background: var(--p1-card);
		border: 1px solid var(--p1-line);
	}

	.box h3 {
		margin-bottom: 0.75rem;
		font-size: 0.9rem;
		font-weight: 800;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
	}

	.stats div {
		padding: 0.55rem 0.7rem;
		border-radius: 0.55rem;
		background: var(--p1-bg);
	}

	.stats dt {
		font-size: 0.72rem;
		color: var(--p1-muted);
	}

	.stats dd {
		font-family: var(--kit-num);
		font-size: 1.2rem;
		font-weight: 800;
		color: var(--primary);
	}

	.cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.cloud button {
		padding: 0.15rem 0.5rem;
		border-radius: 0.35rem;
		font-size: 0.78rem;
		color: var(--p1-soft);
		background: var(--p1-bg);
		transition:
			color 0.15s,
			background 0.15s;
	}

	.cloud button:hover {
		color: var(--primary);
	}

	.cloud button[aria-pressed="true"] {
		color: white;
		background: var(--primary);
	}

	.essays li a {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.5rem 0;
		border-bottom: 1px dashed var(--p1-line);
	}

	.essays li:last-child a {
		border-bottom: none;
	}

	.essays b {
		font-size: 0.85rem;
	}

	.essays a:hover b {
		color: var(--primary);
	}

	.essays span {
		font-size: 0.75rem;
		color: var(--p1-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.others {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.25rem;
	}

	.others a {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.5rem;
		border-radius: 0.45rem;
		font-size: 0.82rem;
		color: var(--p1-soft);
	}

	.others a:hover {
		color: var(--primary);
		background: var(--p1-bg);
	}

	@media (max-width: 1000px) {
		.page {
			grid-template-columns: minmax(0, 1fr);
		}

		.grid:not(.is-list) {
			grid-template-columns: repeat(min(var(--cols), 3), minmax(0, 1fr));
		}
	}
</style>
