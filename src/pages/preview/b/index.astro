---
// 方案 B · 个人主页式（博客优先）：插画首屏 → 单栏笔记时间线（可按分类筛选）→ 在看的番 → 关于我
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "../../../components/LightDarkSwitch.svelte";
import Cover from "../../../components/kit/Cover.astro";
import ImageWrapper from "../../../components/misc/ImageWrapper.astro";
import PreviewSwitch from "../../../components/preview/PreviewSwitch.astro";
import { cnDate, getProtoAnime, getProtoNotes } from "../../../components/preview/proto";
import { profileConfig, siteConfig } from "../../../config";
import Layout from "../../../layouts/Layout.astro";

const [notes, anime] = await Promise.all([getProtoNotes("b"), getProtoAnime()]);
const typeCount = new Map<string, number>();
for (const n of notes) typeCount.set(n.type, (typeCount.get(n.type) ?? 0) + 1);
const types = [...typeCount.entries()].sort((a, b) => b[1] - a[1]);
const banner = "/assets/desktop-banner/custom-bg.jpg";
---

<Layout title="方案 B · 个人主页式">
	<div class="pb" data-no-swup>
		<header class="nav">
			<a href="/preview/b/" class="nav__logo">{siteConfig.title}</a>
			<nav class="nav__links">
				<a href="#notes">笔记</a>
				<a href="#anime">在看</a>
				<a href="#about">关于</a>
			</nav>
			<div class="nav__theme"><LightDarkSwitch client:only="svelte" /></div>
		</header>

		<!-- 首屏：只放头像、站名和一句话 -->
		<section class="hero">
			<img class="hero__bg" src={banner} alt="" />
			<div class="hero__shade"></div>
			<div class="hero__inner">
				<div class="hero__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
				<h1 class="hero__title" data-split>{siteConfig.title}</h1>
				<p class="hero__sub">{siteConfig.subtitle}</p>
			</div>
			<a href="#notes" class="hero__down" aria-label="开始阅读"><Icon name="material-symbols:keyboard-arrow-down-rounded" /></a>
		</section>

		<!-- 笔记时间线 -->
		<main class="notes" id="notes">
			<nav class="filter" aria-label="按分类筛选">
				<button type="button" class="filter__item is-on" data-b-type="">全部 <small>{notes.length}</small></button>
				{types.map(([t, n]) => (
					<button type="button" class="filter__item" data-b-type={t}>{t} <small>{n}</small></button>
				))}
			</nav>

			<div class="list">
				{notes.map((n) => (
					<a href={n.href} class="note" data-type={n.type} data-reveal>
						<div class="note__body">
							<div class="note__meta">
								<span class="note__type">{n.type}</span>
								<time>{cnDate(n.date)}</time>
							</div>
							<h2 class="note__title">{n.title}</h2>
							{n.description && <p class="note__excerpt">{n.description}</p>}
						</div>
						{n.cover && (
							<div class="note__thumb">
								<img src={n.cover} alt="" loading="lazy" referrerpolicy="no-referrer" />
							</div>
						)}
					</a>
				))}
			</div>
		</main>

		<!-- 在看的番 -->
		<section class="anime" id="anime" data-reveal>
			<div class="sec-head">
				<h2>在看的番</h2>
				<a href="/library/anime/">全部 {anime.length} 部 <Icon name="material-symbols:arrow-forward-rounded" /></a>
			</div>
			<div class="posters">
				{anime.slice(0, 8).map((a) => (
					<a href={a.url} class="poster">
						<Cover src={a.cover} title={a.title} aspect="3 / 4">
							{typeof a.rating === "number" && <span class="kit-rating"><Icon name="material-symbols:star-rounded" />{a.rating.toFixed(1)}</span>}
						</Cover>
						<span class="poster__title">{a.title}</span>
					</a>
				))}
			</div>
		</section>

		<!-- 关于我 -->
		<section class="about" id="about" data-reveal>
			<div class="about__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
			<div class="about__name">{profileConfig.name}</div>
			<p class="about__bio">{profileConfig.bio}</p>
			<div class="about__links">
				{profileConfig.links.map((l) => (
					<a href={l.url} target="_blank" rel="noopener noreferrer"><Icon name={l.icon} />{l.name}</a>
				))}
				<a href="/about/"><Icon name="material-symbols:person-outline-rounded" />更多关于我</a>
			</div>
		</section>

		<footer class="foot">© {new Date().getFullYear()} {profileConfig.name} · {siteConfig.title}</footer>
	</div>
	<PreviewSwitch current="b" />
</Layout>

<script>
	// 分类筛选（原型演示用）
	const root = document.querySelector<HTMLElement>(".pb");
	if (root) {
		const btns = [...root.querySelectorAll<HTMLButtonElement>("[data-b-type]")];
		const items = [...root.querySelectorAll<HTMLElement>(".note")];
		for (const b of btns) {
			b.addEventListener("click", () => {
				for (const x of btns) x.classList.toggle("is-on", x === b);
				const t = b.dataset.bType;
				for (const it of items) it.hidden = !!t && it.dataset.type !== t;
			});
		}
	}
</script>

<style>
	.pb {
		--b-text: rgb(28 28 30);
		--b-soft: rgb(80 80 86);
		--b-muted: rgb(140 140 148);
		--b-line: color-mix(in oklch, var(--card-bg) 90%, black);
		background: var(--card-bg);
		color: var(--b-text);
		min-height: 100vh;
	}

	:global(:root.dark) .pb {
		--b-text: rgb(238 238 240);
		--b-soft: rgb(200 200 205);
		--b-muted: rgb(150 150 158);
		--b-line: color-mix(in oklch, var(--card-bg) 85%, white);
	}

	/* 顶栏 */
	.nav {
		position: absolute;
		z-index: 10;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.25rem clamp(1.25rem, 5vw, 4rem);
		color: white;
	}

	.nav__logo {
		font-weight: 800;
		letter-spacing: 0.04em;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);
	}

	.nav__links {
		margin-left: auto;
		display: flex;
		gap: 1.75rem;
		font-size: 0.92rem;
		font-weight: 600;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);
	}

	.nav__theme :global(button) {
		color: white;
	}

	/* 首屏 */
	.hero {
		position: relative;
		height: min(72vh, 46rem);
		min-height: 26rem;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		z-index: -2;
	}

	.hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(to bottom, rgb(0 0 0 / 0.28), transparent 45%),
			linear-gradient(to top, var(--card-bg), transparent 38%);
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 0 1.5rem 3rem;
		color: white;
	}

	.hero__avatar {
		width: 5.5rem;
		height: 5.5rem;
		border-radius: 999px;
		overflow: hidden;
		border: 3px solid rgb(255 255 255 / 0.9);
		box-shadow: 0 16px 36px -14px rgb(0 0 0 / 0.55);
	}

	.hero__title {
		margin-top: 1.1rem;
		font-size: clamp(2.5rem, 6vw, 4.25rem);
		font-weight: 900;
		letter-spacing: 0.05em;
		line-height: 1.1;
		text-shadow: 0 4px 28px rgb(0 0 0 / 0.35);
	}

	.hero__sub {
		margin-top: 0.6rem;
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.4);
	}

	.hero__down {
		position: absolute;
		bottom: 1.25rem;
		left: 50%;
		transform: translateX(-50%);
		font-size: 2rem;
		color: var(--b-muted);
		animation: hero-bob 2.4s ease-in-out infinite;
	}

	@keyframes hero-bob {
		50% {
			transform: translate(-50%, 6px);
		}
	}

	/* 笔记时间线：单栏，读起来像博客 */
	.notes {
		max-width: 46rem;
		margin: 0 auto;
		padding: 1rem 1.25rem 3rem;
	}

	.filter {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		gap: 0.35rem;
		padding: 0.85rem 0;
		overflow-x: auto;
		scrollbar-width: none;
		background: color-mix(in oklch, var(--card-bg) 92%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--b-line);
	}

	.filter__item {
		flex: none;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--b-muted);
		transition:
			color 0.15s,
			background 0.15s;
	}

	.filter__item small {
		font-family: var(--kit-num);
		font-size: 0.72rem;
		font-weight: 500;
		margin-left: 0.15rem;
	}

	.filter__item:hover {
		color: var(--b-text);
	}

	.filter__item.is-on {
		color: var(--card-bg);
		background: var(--b-text);
	}

	.list {
		display: flex;
		flex-direction: column;
	}

	.note {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--b-line);
	}

	.note__body {
		flex: 1;
		min-width: 0;
	}

	.note__meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.8rem;
		color: var(--b-muted);
	}

	.note__type {
		color: var(--primary);
		font-weight: 700;
	}

	.note__title {
		margin-top: 0.45rem;
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.4;
		letter-spacing: 0.01em;
		transition: color 0.15s;
	}

	.note:hover .note__title {
		color: var(--primary);
	}

	.note__excerpt {
		margin-top: 0.45rem;
		font-size: 0.95rem;
		line-height: 1.75;
		color: var(--b-soft);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.note__thumb {
		flex: none;
		width: 9rem;
		aspect-ratio: 4 / 3;
		border-radius: 0.75rem;
		overflow: hidden;
		border: 1px solid var(--b-line);
	}

	.note__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s var(--kit-ease-out);
	}

	.note:hover .note__thumb img {
		transform: scale(1.05);
	}

	/* 在看的番 */
	.anime {
		max-width: 64rem;
		margin: 1rem auto 0;
		padding: 2.5rem 1.25rem;
	}

	.sec-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.sec-head h2 {
		font-size: 1.4rem;
		font-weight: 900;
	}

	.sec-head a {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		font-size: 0.85rem;
		color: var(--b-muted);
	}

	.sec-head a:hover {
		color: var(--primary);
	}

	.posters {
		display: grid;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		gap: 1rem;
	}

	.poster {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		min-width: 0;
	}

	.poster :global(.kit-cover) {
		border-radius: 0.75rem;
		transition:
			transform 0.5s var(--kit-spring),
			box-shadow 0.4s;
	}

	.poster:hover :global(.kit-cover) {
		transform: translateY(-4px);
		box-shadow: 0 18px 34px -20px rgb(0 0 0 / 0.55);
	}

	.poster__title {
		font-size: 0.8rem;
		font-weight: 700;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* 关于我 */
	.about {
		max-width: 36rem;
		margin: 1rem auto 3rem;
		padding: 2.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		border-top: 1px solid var(--b-line);
	}

	.about__avatar {
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 999px;
		overflow: hidden;
	}

	.about__name {
		margin-top: 0.85rem;
		font-size: 1.2rem;
		font-weight: 800;
	}

	.about__bio {
		margin-top: 0.6rem;
		font-size: 0.92rem;
		line-height: 1.85;
		color: var(--b-soft);
	}

	.about__links {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		font-size: 0.875rem;
		color: var(--b-muted);
	}

	.about__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.about__links a:hover {
		color: var(--primary);
	}

	.foot {
		padding: 1.5rem 1rem 5rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--b-muted);
	}

	@media (max-width: 760px) {
		.nav__links {
			display: none;
		}

		.nav__theme {
			margin-left: auto;
		}

		.note {
			gap: 1rem;
			padding: 1.25rem 0;
		}

		.note__title {
			font-size: 1.1rem;
		}

		.note__thumb {
			width: 6rem;
		}

		.posters {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.poster:nth-child(n + 5) {
			display: none;
		}
	}
</style>
