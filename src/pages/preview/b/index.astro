---
// 方案 B · 个人主页 + 数据库：插画首屏 → Bases 式数据库（所有笔记都是带属性的卡片）→ 关于我
// 顶上一排类型标签（全部 / 文章 / 作品 / 动漫 / 月记），下面一排是当前类型的分类，
// 搜索 / 排序 / 分组 / 卡片-列表切换都交给 kit.ts 的卡片引擎
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "../../../components/LightDarkSwitch.svelte";
import ImageWrapper from "../../../components/misc/ImageWrapper.astro";
import BaseCard from "../../../components/preview/BaseCard.astro";
import PreviewSwitch from "../../../components/preview/PreviewSwitch.astro";
import { BASE_KINDS, type BaseRow, getProtoBase } from "../../../components/preview/proto";
import { profileConfig, siteConfig } from "../../../config";
import Layout from "../../../layouts/Layout.astro";

const rows = (await getProtoBase("b")).sort((a, b) => a.kindOrder - b.kindOrder || b.date.localeCompare(a.date));
const ofKind = (k: string) => rows.filter((r) => r.kind === k);
const kinds = BASE_KINDS.filter((k) => ofKind(k).length > 0);

// 某个类型下每个值出现几次，按次数排
function tally(list: BaseRow[], pick: (r: BaseRow) => string[]) {
	const m = new Map<string, number>();
	for (const r of list) for (const v of pick(r)) if (v) m.set(v, (m.get(v) ?? 0) + 1);
	return [...m.entries()].sort((a, b) => b[1] - a[1]);
}
// 每个类型的第二排：文章 / 作品按分类，动漫按文件标签
const facets = [
	{ kind: "文章", label: "分类", attr: "cat", values: tally(ofKind("文章"), (r) => [r.cat]), isDefault: true },
	{ kind: "作品", label: "类别", attr: "cat", values: tally(ofKind("作品"), (r) => [r.cat]), isDefault: false },
	{ kind: "动漫", label: "文件标签", attr: "tag", values: tally(ofKind("动漫"), (r) => r.tags).slice(0, 12), isDefault: false },
];

const KIND_ICON: Record<string, string> = {
	文章: "material-symbols:article-outline-rounded",
	作品: "material-symbols:work-outline",
	动漫: "material-symbols:movie-outline-rounded",
	月记: "material-symbols:calendar-month-outline-rounded",
};
const banner = "/assets/desktop-banner/custom-bg.jpg";
---

<Layout title="方案 B · 主页 + 数据库">
	<div class="pb" data-no-swup>
		<header class="nav">
			<a href="/preview/b/" class="nav__logo">{siteConfig.title}</a>
			<nav class="nav__links">
				<a href="#notes">笔记</a>
				<a href="#about">关于</a>
			</nav>
			<div class="nav__theme"><LightDarkSwitch client:only="svelte" /></div>
		</header>

		<!-- 首屏：只放头像、站名和一句话，压矮一点，数据库在第一屏就能看到 -->
		<section class="hero">
			<img class="hero__bg" src={banner} alt="" />
			<div class="hero__shade"></div>
			<div class="hero__inner">
				<div class="hero__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
				<h1 class="hero__title" data-split>{siteConfig.title}</h1>
				<p class="hero__sub">{siteConfig.subtitle}</p>
			</div>
		</section>

		<!-- 数据库 -->
		<section class="db" id="notes" data-collection data-default-group="kind" data-default-sort="date">
			<div class="db__bar">
				<div class="db__inner db__bar-inner">
					<div class="kit-tabs vtabs" data-tabs role="group" aria-label="类型">
						<button type="button" class="kit-tabs__item" data-filter-kind="" aria-pressed="true">
							<Icon name="material-symbols:database" />全部<small>{rows.length}</small>
						</button>
						{
							kinds.map((k) => (
								<button type="button" class="kit-tabs__item" data-filter-kind={k} aria-pressed="false">
									<Icon name={KIND_ICON[k]} />
									{k}
									<small>{ofKind(k).length}</small>
								</button>
							))
						}
					</div>

					<div class="db__tools">
						<span class="db__count"><b data-count-out>{rows.length}</b> 条</span>
						<label class="kit-search">
							<Icon name="material-symbols:search-rounded" class="kit-search__icon" />
							<input class="kit-input" type="search" data-search placeholder="搜索标题、分类、标签" aria-label="搜索" />
							<kbd class="db__kbd" title="按 / 搜索">/</kbd>
						</label>
						<label class="kit-select-wrap">
							<Icon name="material-symbols:swap-vert-rounded" />
							<select class="kit-select" data-sort aria-label="排序">
								<option value="date" selected>按日期</option>
								<option value="title">按标题</option>
								<option value="rating">按评分</option>
							</select>
						</label>
						<label class="kit-select-wrap">
							<Icon name="material-symbols:segment-rounded" />
							<select class="kit-select" data-group aria-label="分组">
								<option value="">不分组</option>
								<option value="kind" selected>按类型</option>
								<option value="cat">按分类</option>
								<option value="year">按年份</option>
								<option value="rating">按评分</option>
							</select>
						</label>
						<div class="kit-tabs" data-tabs role="group" aria-label="视图">
							<button type="button" class="kit-tabs__item" data-view="cards" aria-pressed="true" title="卡片">
								<Icon name="material-symbols:grid-view-outline-rounded" />
							</button>
							<button type="button" class="kit-tabs__item" data-view="list" aria-pressed="false" title="列表">
								<Icon name="material-symbols:view-list-outline-rounded" />
							</button>
						</div>
					</div>
				</div>
			</div>

			<div class="db__inner">
				<!-- 第二排：只显示当前类型的分类（没选类型时显示文章分类） -->
				<div class="db__facets">
					<button type="button" class="chip is-active-tag" data-active-tag hidden title="取消这个标签">
						<Icon name="material-symbols:tag-rounded" />
						<span data-tag-out></span>
						<Icon name="material-symbols:close" />
					</button>
					{
						facets.map((f) => (
							<>
								<span class="db__facet-label" data-scope={f.kind} data-scope-default={f.isDefault ? "" : undefined} hidden={!f.isDefault}>
									<Icon name="material-symbols:label-outline" />
									{f.label}
								</span>
								{f.values.map(([v, n]) => (
									<button
										type="button"
										class="chip"
										data-scope={f.kind}
										data-scope-default={f.isDefault ? "" : undefined}
										hidden={!f.isDefault}
										aria-pressed="false"
										{...(f.attr === "cat" ? { "data-filter-cat": v } : { "data-filter": v })}
									>
										{v}
										<small>{n}</small>
									</button>
								))}
							</>
						))
					}
				</div>

				<div class="kit-grid db__grid" data-items>
					{rows.map((r, i) => <BaseCard row={r} index={i} />)}
				</div>
			</div>
		</section>

		<!-- 关于我 -->
		<section class="about" id="about" data-reveal>
			<div class="about__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
			<div class="about__name">{profileConfig.name}</div>
			<p class="about__bio">{profileConfig.bio}</p>
			<div class="about__links">
				{
					profileConfig.links.map((l) => (
						<a href={l.url} target="_blank" rel="noopener noreferrer">
							<Icon name={l.icon} />
							{l.name}
						</a>
					))
				}
				<a href="/about/"><Icon name="material-symbols:person-outline-rounded" />更多关于我</a>
			</div>
		</section>

		<footer class="foot">© {new Date().getFullYear()} {profileConfig.name} · {siteConfig.title}</footer>
	</div>
	<PreviewSwitch current="b" />
</Layout>

<style>
	.pb {
		--db-bg: color-mix(in oklch, var(--card-bg) 96.5%, black);
		--db-card: var(--card-bg);
		--db-text: rgb(28 28 30);
		--db-soft: rgb(70 70 76);
		--db-muted: rgb(138 138 146);
		--db-line: color-mix(in oklch, var(--card-bg) 90%, black);
		background: var(--db-bg);
		color: var(--db-text);
		min-height: 100vh;
	}

	:global(:root.dark) .pb {
		--db-bg: color-mix(in oklch, var(--card-bg) 82%, black);
		--db-text: rgb(238 238 240);
		--db-soft: rgb(205 205 210);
		--db-muted: rgb(145 145 152);
		--db-line: color-mix(in oklch, var(--card-bg) 86%, white);
	}

	/* 顶栏：浮在首屏上 */
	.nav {
		position: absolute;
		z-index: 10;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.25rem clamp(1.25rem, 5vw, 4rem);
		color: white;
	}

	.nav__logo {
		font-weight: 800;
		letter-spacing: 0.04em;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);
	}

	.nav__links {
		margin-left: auto;
		display: flex;
		gap: 1.75rem;
		font-size: 0.92rem;
		font-weight: 600;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);
	}

	.nav__theme :global(button) {
		color: white;
	}

	/* 首屏 */
	.hero {
		position: relative;
		height: clamp(20rem, 44vh, 28rem);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		z-index: -2;
	}

	.hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(to bottom, rgb(0 0 0 / 0.3), transparent 45%),
			linear-gradient(to top, var(--db-bg), transparent 45%);
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 1rem 1.5rem 2rem;
		color: white;
	}

	.hero__avatar {
		width: 4.75rem;
		height: 4.75rem;
		border-radius: 999px;
		overflow: hidden;
		border: 3px solid rgb(255 255 255 / 0.9);
		box-shadow: 0 16px 36px -14px rgb(0 0 0 / 0.55);
	}

	.hero__title {
		margin-top: 0.9rem;
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		font-weight: 900;
		letter-spacing: 0.05em;
		line-height: 1.1;
		text-shadow: 0 4px 28px rgb(0 0 0 / 0.35);
	}

	.hero__sub {
		margin-top: 0.5rem;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.4);
	}

	/* ---------- 数据库 ---------- */
	.db__inner {
		max-width: 96rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 3vw, 2rem);
	}

	/* 类型标签 + 工具：吸顶 */
	.db__bar {
		position: sticky;
		top: 0;
		z-index: 6;
		background: color-mix(in oklch, var(--db-bg) 88%, transparent);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom: 1px solid var(--db-line);
	}

	.db__bar-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1rem;
	}

	/* 类型标签：底部滑动下划线，像 Obsidian Bases 的视图切换 */
	.vtabs {
		padding: 0;
		background: none;
		border-radius: 0;
		gap: 0.15rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.vtabs .kit-tabs__item {
		height: 3.4rem;
		gap: 0.4rem;
		padding: 0 0.85rem;
		border-radius: 0;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--db-muted);
		transition: color 0.2s;
	}

	.vtabs .kit-tabs__item :global(svg) {
		font-size: 1.1rem;
	}

	.vtabs .kit-tabs__item small {
		font-family: var(--kit-num);
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0 0.35rem;
		border-radius: 0.35rem;
		background: var(--btn-regular-bg);
	}

	.vtabs .kit-tabs__item:hover {
		color: var(--db-text);
	}

	.vtabs .kit-tabs__item[aria-pressed="true"] {
		color: var(--db-text);
	}

	.vtabs .kit-tabs__item[aria-pressed="true"] small {
		color: white;
		background: var(--primary);
	}

	.vtabs :global(.kit-tabs__ind) {
		top: auto;
		bottom: -1px;
		height: 2.5px;
		border-radius: 2px;
		background: var(--primary);
	}

	.db__tools {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 0;
	}

	.db__count {
		font-size: 0.85rem;
		color: var(--db-muted);
		margin-right: 0.25rem;
		white-space: nowrap;
	}

	.db__count b {
		font-family: var(--kit-num);
		color: var(--primary);
		margin-right: 0.1rem;
	}

	.db__tools .kit-input {
		width: 14rem;
		padding-right: 2rem;
	}

	.db__kbd {
		position: absolute;
		right: 0.5rem;
		display: grid;
		place-items: center;
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 0.3rem;
		font-family: var(--kit-num);
		font-size: 0.7rem;
		color: var(--db-muted);
		border: 1px solid var(--db-line);
		background: var(--db-card);
		pointer-events: none;
		transition: opacity 0.15s;
	}

	.kit-search:focus-within .db__kbd {
		opacity: 0;
	}

	/* 第二排：分类 chip */
	.db__facets {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		padding: 1.1rem 0 0.25rem;
	}

	.db__facets:not(:has(.chip:not([hidden]))) {
		display: none;
	}

	.db__facet-label {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-right: 0.35rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--db-muted);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 1.9rem;
		padding: 0 0.75rem;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--db-soft);
		background: var(--db-card);
		border: 1px solid var(--db-line);
		transition:
			color 0.15s,
			border-color 0.15s,
			background 0.15s;
	}

	.chip small {
		font-family: var(--kit-num);
		font-size: 0.7rem;
		color: var(--db-muted);
	}

	.chip:hover {
		color: var(--primary);
		border-color: color-mix(in oklch, var(--db-line) 40%, var(--primary));
	}

	.chip[aria-pressed="true"] {
		color: white;
		background: var(--primary);
		border-color: var(--primary);
	}

	.chip[aria-pressed="true"] small {
		color: rgb(255 255 255 / 0.75);
	}

	/* 当前生效、但不在上面按钮里的标签 */
	.chip.is-active-tag {
		order: -1;
		color: white;
		background: var(--primary);
		border-color: var(--primary);
		padding: 0 0.55rem 0 0.6rem;
	}

	.chip.is-active-tag :global(svg) {
		font-size: 0.95rem;
	}

	.chip[hidden],
	.db__facet-label[hidden] {
		display: none;
	}

	/* 卡片网格：宽屏 8 列（窄一点 6 / 4 / 2 列），文章 / 作品 / 月记这类横图卡片占 2 列，番剧海报占 1 列 */
	.db__grid {
		gap: 1.1rem;
		padding: 1.25rem 0 3rem;
	}

	.db__grid:not(.is-list) {
		grid-template-columns: repeat(8, minmax(0, 1fr));
	}

	@media (max-width: 1400px) {
		.db__grid:not(.is-list) {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
	}

	.db__grid :global(.kit-group-head) {
		margin-top: 1.5rem;
		font-size: 1.2rem;
		font-weight: 900;
	}

	.db__grid :global(.kit-group-head:first-child) {
		margin-top: 0.25rem;
	}

	/* 关于我 */
	.about {
		max-width: 36rem;
		margin: 1rem auto 2rem;
		padding: 2.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		border-top: 1px solid var(--db-line);
	}

	.about__avatar {
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 999px;
		overflow: hidden;
	}

	.about__name {
		margin-top: 0.85rem;
		font-size: 1.2rem;
		font-weight: 800;
	}

	.about__bio {
		margin-top: 0.6rem;
		font-size: 0.92rem;
		line-height: 1.85;
		color: var(--db-soft);
	}

	.about__links {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		font-size: 0.875rem;
		color: var(--db-muted);
	}

	.about__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.about__links a:hover {
		color: var(--primary);
	}

	.foot {
		padding: 1.5rem 1rem 5rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--db-muted);
	}

	@media (max-width: 1100px) {
		.db__grid:not(.is-list) {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.db__tools {
			width: 100%;
			padding-top: 0;
		}

		.db__tools .kit-input {
			width: 100%;
		}

		.db__tools .kit-search {
			flex: 1;
		}
	}

	@media (max-width: 760px) {
		.nav__links {
			display: none;
		}

		.nav__theme {
			margin-left: auto;
		}

		.db__grid:not(.is-list) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.db__count,
		.db__kbd,
		.db__tools .kit-select-wrap {
			display: none;
		}

		/* 类型标签放不下时可以横滑，右边渐隐提示还有 */
		.vtabs {
			max-width: 100%;
			-webkit-mask-image: linear-gradient(to right, black 85%, transparent);
			mask-image: linear-gradient(to right, black 85%, transparent);
		}

		.vtabs .kit-tabs__item {
			height: 3rem;
			padding: 0 0.6rem;
		}
	}
</style>
