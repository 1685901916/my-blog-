---
// 方案 B · 个人主页 + 数据库：插画首屏 → 数据库 → 关于我
// 数据库顶上一排类型标签（全部 / 文章 / 动画 / 漫画 / 小说 / 游戏 / 人物 / 作品 / 月记 / 收集）：
//   「全部」是总览，每种类型一排，排尾「全部 →」进入该类型；
//   选了类型就是这个类型的完整网格，第二排是它自己的分类（动画 → 异能系 / 恋爱 / 现实系 …）
// 搜索 / 排序 / 卡片-列表切换交给 kit.ts 的卡片引擎
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "../../../components/LightDarkSwitch.svelte";
import ImageWrapper from "../../../components/misc/ImageWrapper.astro";
import BaseCard from "../../../components/preview/BaseCard.astro";
import PreviewSwitch from "../../../components/preview/PreviewSwitch.astro";
import { BASE_KINDS, getProtoBase, KIND_META } from "../../../components/preview/proto";
import { profileConfig, siteConfig } from "../../../config";
import Layout from "../../../layouts/Layout.astro";

const rows = await getProtoBase();
const ofKind = (k: string) => rows.filter((r) => r.kind === k);
const kinds = BASE_KINDS.filter((k) => ofKind(k).length > 0);

// 每个类型的分类和数量（第二排的筛选按钮）
const facets = kinds
	.map((kind) => {
		const m = new Map<string, number>();
		for (const r of ofKind(kind)) if (r.cat) m.set(r.cat, (m.get(r.cat) ?? 0) + 1);
		return { kind, label: KIND_META[kind].facet, values: [...m.entries()].sort((a, b) => b[1] - a[1]) };
	})
	.filter((f) => f.values.length > 1);

// 总览每排放几个：海报 / 头像一排 8 个，文字卡 / 截图卡一排 4 个
const wide = (k: (typeof kinds)[number]) => !["poster", "person"].includes(KIND_META[k].variant);
const banner = "/assets/desktop-banner/custom-bg.jpg";
---

<Layout title="方案 B · 主页 + 数据库">
	<div class="pb" data-no-swup>
		<header class="nav">
			<a href="/preview/b/" class="nav__logo">{siteConfig.title}</a>
			<nav class="nav__links">
				<a href="#notes">笔记</a>
				<a href="#about">关于</a>
			</nav>
			<div class="nav__theme"><LightDarkSwitch client:only="svelte" /></div>
		</header>

		<section class="hero">
			<img class="hero__bg" src={banner} alt="" />
			<div class="hero__shade"></div>
			<div class="hero__inner">
				<div class="hero__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
				<h1 class="hero__title" data-split>{siteConfig.title}</h1>
				<p class="hero__sub">{siteConfig.subtitle}</p>
			</div>
		</section>

		<section class="db" id="notes" data-collection data-default-sort="auto" data-default-group="kind">
			<div class="db__bar">
				<div class="db__inner db__bar-inner">
					<div class="kit-tabs vtabs" data-tabs role="group" aria-label="类型">
						<button type="button" class="kit-tabs__item" data-filter-kind="" aria-pressed="true">
							<Icon name="material-symbols:home-outline-rounded" />全部
						</button>
						{
							kinds.map((k) => (
								<button type="button" class="kit-tabs__item" data-filter-kind={k} aria-pressed="false">
									<Icon name={KIND_META[k].icon} />
									{k}
									<small>{ofKind(k).length}</small>
								</button>
							))
						}
					</div>

					<div class="db__tools">
						<label class="kit-search">
							<Icon name="material-symbols:search-rounded" class="kit-search__icon" />
							<input class="kit-input" type="search" data-search placeholder="搜索全部笔记" aria-label="搜索" />
							<kbd class="db__kbd" title="按 / 搜索">/</kbd>
						</label>
						<label class="kit-select-wrap">
							<Icon name="material-symbols:swap-vert-rounded" />
							<select class="kit-select" data-sort aria-label="排序">
								<option value="auto" selected>推荐</option>
								<option value="date">最新</option>
								<option value="rating">评分</option>
								<option value="title">名称</option>
							</select>
						</label>
						<div class="kit-tabs" data-tabs role="group" aria-label="视图">
							<button type="button" class="kit-tabs__item" data-view="cards" aria-pressed="true" title="卡片">
								<Icon name="material-symbols:grid-view-outline-rounded" />
							</button>
							<button type="button" class="kit-tabs__item" data-view="list" aria-pressed="false" title="列表">
								<Icon name="material-symbols:view-list-outline-rounded" />
							</button>
						</div>
					</div>
				</div>
			</div>

			<div class="db__inner">
				<!-- 第二排：当前类型的分类；从阅读页点标签进来时最前面多一个可以取消的标签 -->
				<div class="db__facets">
					<button type="button" class="chip is-active-tag" data-active-tag hidden title="取消这个标签">
						<Icon name="material-symbols:tag-rounded" />
						<span data-tag-out></span>
						<Icon name="material-symbols:close" />
					</button>
					{
						facets.map((f) => (
							<>
								<span class="db__facet-label" data-scope={f.kind} hidden>
									{f.label}
								</span>
								<button type="button" class="chip" data-scope={f.kind} data-filter-cat="" aria-pressed="true" hidden>
									全部
								</button>
								{f.values.map(([v, n]) => (
									<button type="button" class="chip" data-scope={f.kind} data-filter-cat={v} aria-pressed="false" hidden>
										{v}
										<small>{n}</small>
									</button>
								))}
							</>
						))
					}
				</div>

				<!-- 总览：每种类型一排 -->
				<div class="ov" data-overview>
					{
						kinds.map((k) => (
							<section class="ov__row">
								<header class="ov__head">
									<h2>
										<Icon name={KIND_META[k].icon} />
										{k}
									</h2>
									<span class="ov__count">{ofKind(k).length}</span>
									<button type="button" class="ov__more" data-filter-kind={k}>
										全部
										<Icon name="material-symbols:arrow-forward-rounded" />
									</button>
								</header>
								<div class:list={["kit-grid", "db__grid", "ov__grid", wide(k) ? "is-wide" : "is-narrow"]}>
									{ofKind(k)
										.slice(0, wide(k) ? 4 : 8)
										.map((r, n) => (
											<BaseCard row={r} index={n} engine={false} />
										))}
								</div>
							</section>
						))
					}
				</div>

				<div class="kit-grid db__grid" data-items hidden>
					{rows.map((r, i) => <BaseCard row={r} index={i} />)}
				</div>
			</div>
		</section>

		<section class="about" id="about" data-reveal>
			<div class="about__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
			<div class="about__name">{profileConfig.name}</div>
			<p class="about__bio">{profileConfig.bio}</p>
			<div class="about__links">
				{
					profileConfig.links.map((l) => (
						<a href={l.url} target="_blank" rel="noopener noreferrer">
							<Icon name={l.icon} />
							{l.name}
						</a>
					))
				}
				<a href="/about/"><Icon name="material-symbols:person-outline-rounded" />更多关于我</a>
			</div>
		</section>

		<footer class="foot">© {new Date().getFullYear()} {profileConfig.name} · {siteConfig.title}</footer>
	</div>
	<PreviewSwitch current="b" />
</Layout>

<style>
	.pb {
		--db-bg: color-mix(in oklch, var(--card-bg) 96.5%, black);
		--db-card: var(--card-bg);
		--db-sunk: color-mix(in oklch, var(--card-bg) 92%, black);
		--db-text: rgb(28 28 30);
		--db-soft: rgb(80 80 88);
		--db-muted: rgb(140 140 148);
		--db-line: color-mix(in oklch, var(--card-bg) 90%, black);
		background: var(--db-bg);
		color: var(--db-text);
		min-height: 100vh;
	}

	:global(:root.dark) .pb {
		--db-bg: color-mix(in oklch, var(--card-bg) 82%, black);
		--db-sunk: color-mix(in oklch, var(--card-bg) 75%, black);
		--db-text: rgb(238 238 240);
		--db-soft: rgb(200 200 206);
		--db-muted: rgb(145 145 152);
		--db-line: color-mix(in oklch, var(--card-bg) 86%, white);
	}

	/* 顶栏：浮在首屏上 */
	.nav {
		position: absolute;
		z-index: 10;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.25rem clamp(1.25rem, 5vw, 4rem);
		color: white;
	}

	.nav__logo {
		font-weight: 800;
		letter-spacing: 0.04em;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);
	}

	.nav__links {
		margin-left: auto;
		display: flex;
		gap: 1.75rem;
		font-size: 0.92rem;
		font-weight: 600;
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);
	}

	.nav__theme :global(button) {
		color: white;
	}

	/* 首屏 */
	.hero {
		position: relative;
		height: clamp(18rem, 40vh, 26rem);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		z-index: -2;
	}

	.hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(to bottom, rgb(0 0 0 / 0.3), transparent 45%),
			linear-gradient(to top, var(--db-bg), transparent 50%);
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 1rem 1.5rem 2.5rem;
		color: white;
	}

	.hero__avatar {
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 999px;
		overflow: hidden;
		border: 3px solid rgb(255 255 255 / 0.9);
		box-shadow: 0 16px 36px -14px rgb(0 0 0 / 0.55);
	}

	.hero__title {
		margin-top: 0.85rem;
		font-size: clamp(2rem, 4.5vw, 3.2rem);
		font-weight: 900;
		letter-spacing: 0.05em;
		line-height: 1.1;
		text-shadow: 0 4px 28px rgb(0 0 0 / 0.35);
	}

	.hero__sub {
		margin-top: 0.5rem;
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.4);
	}

	/* ---------- 数据库 ---------- */
	.db__inner {
		max-width: 96rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 3vw, 2rem);
	}

	.db__bar {
		position: sticky;
		top: 0;
		z-index: 6;
		background: color-mix(in oklch, var(--db-bg) 86%, transparent);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		backdrop-filter: blur(16px) saturate(1.4);
		border-bottom: 1px solid var(--db-line);
	}

	.db__bar-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1rem;
	}

	/* 类型标签：底部滑动下划线 */
	.vtabs {
		padding: 0;
		background: none;
		border-radius: 0;
		gap: 0.1rem;
		overflow-x: auto;
		scrollbar-width: none;
		max-width: 100%;
	}

	.vtabs .kit-tabs__item {
		height: 3.3rem;
		gap: 0.35rem;
		padding: 0 0.7rem;
		border-radius: 0;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--db-muted);
		transition: color 0.2s;
	}

	.vtabs .kit-tabs__item :global(svg) {
		font-size: 1.05rem;
	}

	.vtabs .kit-tabs__item small {
		font-family: var(--kit-num);
		font-size: 0.7rem;
		font-weight: 600;
		opacity: 0.7;
	}

	.vtabs .kit-tabs__item:hover,
	.vtabs .kit-tabs__item[aria-pressed="true"] {
		color: var(--db-text);
	}

	.vtabs .kit-tabs__item[aria-pressed="true"] small {
		color: var(--primary);
		opacity: 1;
	}

	.vtabs :global(.kit-tabs__ind) {
		top: auto;
		bottom: -1px;
		height: 2.5px;
		border-radius: 2px;
		background: var(--primary);
	}

	.db__tools {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0;
	}

	.db__tools .kit-input {
		width: 13rem;
		padding-right: 2rem;
	}

	.db__kbd {
		position: absolute;
		right: 0.5rem;
		display: grid;
		place-items: center;
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 0.3rem;
		font-family: var(--kit-num);
		font-size: 0.7rem;
		color: var(--db-muted);
		border: 1px solid var(--db-line);
		background: var(--db-card);
		pointer-events: none;
		transition: opacity 0.15s;
	}

	.kit-search:focus-within .db__kbd {
		opacity: 0;
	}

	/* 第二排：分类 chip（总览时整排藏起来） */
	.db__facets {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		padding: 1.1rem 0 0;
	}

	.db__facets:not(:has(.chip:not([hidden]))) {
		display: none;
	}

	.db__facet-label {
		margin-right: 0.25rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--db-muted);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 1.9rem;
		padding: 0 0.8rem;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--db-soft);
		background: var(--db-card);
		border: 1px solid var(--db-line);
		transition:
			color 0.15s,
			border-color 0.15s,
			background 0.15s;
	}

	.chip small {
		font-family: var(--kit-num);
		font-size: 0.7rem;
		color: var(--db-muted);
	}

	.chip:hover {
		color: var(--primary);
		border-color: color-mix(in oklch, var(--db-line) 40%, var(--primary));
	}

	.chip[aria-pressed="true"] {
		color: white;
		background: var(--db-text);
		border-color: var(--db-text);
	}

	.chip[aria-pressed="true"] small {
		color: rgb(255 255 255 / 0.7);
	}

	:global(:root.dark) .chip[aria-pressed="true"] {
		color: var(--db-bg);
	}

	.chip.is-active-tag {
		color: white;
		background: var(--primary);
		border-color: var(--primary);
		padding: 0 0.55rem 0 0.6rem;
	}

	.chip[hidden],
	.db__facet-label[hidden] {
		display: none;
	}

	/* ---------- 网格：宽屏 8 列，文字卡 / 截图卡占 2 列，海报 / 头像占 1 列 ---------- */
	.db__grid {
		gap: 1.6rem 1.1rem;
	}

	.db__grid:not(.is-list) {
		grid-template-columns: repeat(8, minmax(0, 1fr));
	}

	.db__grid:not(.is-list) > :global(.is-text),
	.db__grid:not(.is-list) > :global(.is-shot),
	.db__grid:not(.is-list) > :global(.is-month) {
		grid-column: span 2;
	}

	.db__grid.is-list {
		gap: 0.5rem;
	}

	.db__grid[data-items] {
		padding: 1.5rem 0 3rem;
	}

	.db__grid :global(.kit-group-head) {
		margin-top: 1.5rem;
		font-size: 1.15rem;
		font-weight: 900;
	}

	.db__grid :global(.kit-group-head:first-child) {
		margin-top: 0;
	}

	/* ---------- 总览 ---------- */
	.ov {
		padding: 0.5rem 0 2rem;
	}

	.ov__row {
		padding-top: 2.25rem;
	}

	.ov__head {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		margin-bottom: 1rem;
	}

	.ov__head h2 {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 1.3rem;
		font-weight: 900;
		letter-spacing: 0.02em;
	}

	.ov__head h2 :global(svg) {
		font-size: 1.2rem;
		color: var(--primary);
	}

	.ov__count {
		font-family: var(--kit-num);
		font-size: 0.85rem;
		color: var(--db-muted);
	}

	.ov__more {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.3rem 0.4rem 0.3rem 0.75rem;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--db-soft);
		transition:
			color 0.15s,
			background 0.15s;
	}

	.ov__more:hover {
		color: var(--primary);
		background: var(--db-card);
	}

	/* 关于我 */
	.about {
		max-width: 36rem;
		margin: 1rem auto 2rem;
		padding: 2.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		border-top: 1px solid var(--db-line);
	}

	.about__avatar {
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 999px;
		overflow: hidden;
	}

	.about__name {
		margin-top: 0.85rem;
		font-size: 1.2rem;
		font-weight: 800;
	}

	.about__bio {
		margin-top: 0.6rem;
		font-size: 0.92rem;
		line-height: 1.85;
		color: var(--db-soft);
	}

	.about__links {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		font-size: 0.875rem;
		color: var(--db-muted);
	}

	.about__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.about__links a:hover {
		color: var(--primary);
	}

	.foot {
		padding: 1.5rem 1rem 5rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--db-muted);
	}

	/* 列数随宽度减少；总览每排只放满一行 */
	@media (max-width: 1400px) {
		.db__grid:not(.is-list) {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.ov__grid.is-narrow > :global(:nth-child(n + 7)),
		.ov__grid.is-wide > :global(:nth-child(n + 4)) {
			display: none;
		}
	}

	@media (max-width: 1100px) {
		.db__grid:not(.is-list) {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.ov__grid.is-narrow > :global(:nth-child(n + 5)),
		.ov__grid.is-wide > :global(:nth-child(n + 3)) {
			display: none;
		}

		.db__tools {
			width: 100%;
			padding-top: 0;
		}

		.db__tools .kit-search {
			flex: 1;
		}

		.db__tools .kit-input {
			width: 100%;
		}
	}

	@media (max-width: 760px) {
		.nav__links {
			display: none;
		}

		.nav__theme {
			margin-left: auto;
		}

		.db__grid:not(.is-list) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.1rem 0.75rem;
		}

		.db__grid:not(.is-list) > :global(.is-text),
		.db__grid:not(.is-list) > :global(.is-shot),
		.db__grid:not(.is-list) > :global(.is-month) {
			grid-column: 1 / -1;
		}

		/* 手机上海报一排 3 个，总览放两排 */
		.ov__grid.is-narrow > :global(:nth-child(-n + 6)) {
			display: block;
		}

		.ov__grid.is-wide > :global(:nth-child(n + 3)) {
			display: none;
		}

		.db__kbd,
		.db__tools .kit-select-wrap {
			display: none;
		}

		.vtabs {
			-webkit-mask-image: linear-gradient(to right, black 85%, transparent);
			mask-image: linear-gradient(to right, black 85%, transparent);
		}

		.vtabs .kit-tabs__item {
			height: 3rem;
			padding: 0 0.55rem;
		}
	}
</style>
