---
// 方案 B · 个人主页 + 数据库
// 首屏：电影感横幅，站名 / 头像 / 统计压在左下角
// 「全部」是杂志式总览：全部文章（带配图）→ 动画书架 → 漫画 | 小说 → 人物 → 游戏 | 月记 → 作品 → 收集
// 选了某个类型：这个类型的完整数据库网格，第二排是它自己的分类；搜索 / 排序 / 视图交给 kit.ts
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "../../../components/LightDarkSwitch.svelte";
import ImageWrapper from "../../../components/misc/ImageWrapper.astro";
import BaseCard from "../../../components/preview/BaseCard.astro";
import PreviewSwitch from "../../../components/preview/PreviewSwitch.astro";
import { BASE_KINDS, getProtoBase, type Kind, KIND_META } from "../../../components/preview/proto";
import { profileConfig, siteConfig } from "../../../config";
import Layout from "../../../layouts/Layout.astro";

const rows = await getProtoBase();
const ofKind = (k: string) => rows.filter((r) => r.kind === k);
const kinds = BASE_KINDS.filter((k) => ofKind(k).length > 0);

const facets = kinds
	.map((kind) => {
		const m = new Map<string, number>();
		for (const r of ofKind(kind)) if (r.cat) m.set(r.cat, (m.get(r.cat) ?? 0) + 1);
		return { kind, label: KIND_META[kind].facet, values: [...m.entries()].sort((a, b) => b[1] - a[1]) };
	})
	.filter((f) => f.values.length > 1);

// 总览的版式：每一排放哪些类型、各占几栏（12 栏）、放几个、内部几列
// feature：第一张做成横版大卡（占两格）
type Block = { k: Kind; span: number; n: number; cols: number; desc: string; feature?: boolean };
const LAYOUT: Block[][] = [
	// 最上面放全部文章：配图卡片一排 4 篇，第一篇是横版大卡，15 篇刚好排满 4 排
	[{ k: "文章", span: 12, n: 99, cols: 4, desc: "教程、资源整理和随笔", feature: true }],
	[{ k: "动画", span: 12, n: 8, cols: 8, desc: "看过的番，和看完写下的感想" }],
	[
		{ k: "漫画", span: 6, n: 4, cols: 4, desc: "最近在追的漫画" },
		{ k: "小说", span: 6, n: 4, cols: 4, desc: "轻小说、网文和文学" },
	],
	[{ k: "人物", span: 12, n: 8, cols: 8, desc: "喜欢的角色、声优、音乐人和画师" }],
	[
		{ k: "游戏", span: 7, n: 4, cols: 4, desc: "玩过的游戏" },
		{ k: "月记", span: 5, n: 2, cols: 1, desc: "每个月的碎碎念" },
	],
	[{ k: "作品", span: 12, n: 3, cols: 3, desc: "自己做的东西" }],
	[{ k: "收集", span: 12, n: 9, cols: 3, desc: "制作者、杂项和随手记" }],
];
const layout = LAYOUT.map((row) => row.filter((b) => ofKind(b.k).length > 0)).filter((row) => row.length);
const stat = (k: Kind) => ofKind(k).length;
const banner = "/assets/desktop-banner/custom-bg.jpg";
---

<Layout title="方案 B · 主页 + 数据库">
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600;700;900&display=swap" rel="stylesheet" />
	</Fragment>

	<div class="pb" data-no-swup>
		<header class="nav">
			<a href="/preview/b/" class="nav__logo">{siteConfig.title}</a>
			<nav class="nav__links">
				<a href="#notes">笔记</a>
				<a href="#about">关于</a>
			</nav>
			<div class="nav__theme"><LightDarkSwitch client:only="svelte" /></div>
		</header>

		<!-- 首屏：横幅 + 左下角的站名和统计 -->
		<section class="hero">
			<img class="hero__bg" src={banner} alt="" />
			<div class="hero__shade"></div>
			<div class="hero__inner">
				<div class="hero__id">
					<div class="hero__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
					<div>
						<h1 class="hero__title" data-split>{siteConfig.title}</h1>
						<p class="hero__sub">{siteConfig.subtitle}</p>
					</div>
				</div>
				<dl class="hero__stats">
					{
						(["动画", "漫画", "小说", "人物", "文章"] as Kind[]).map((k) => (
							<div>
								<dd>{stat(k)}</dd>
								<dt>{k}</dt>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<section class="db" id="notes" data-collection data-default-sort="auto" data-default-group="kind">
			<div class="db__bar">
				<div class="wrap db__bar-inner">
					<div class="kit-tabs vtabs" data-tabs role="group" aria-label="类型">
						<button type="button" class="kit-tabs__item" data-filter-kind="" aria-pressed="true">全部</button>
						{
							kinds.map((k) => (
								<button type="button" class="kit-tabs__item" data-filter-kind={k} aria-pressed="false">
									{k}
									<small>{ofKind(k).length}</small>
								</button>
							))
						}
					</div>
					<div class="db__tools">
						<label class="kit-search">
							<Icon name="material-symbols:search-rounded" class="kit-search__icon" />
							<input class="kit-input" type="search" data-search placeholder="搜索全部笔记" aria-label="搜索" />
							<kbd class="db__kbd" title="按 / 搜索">/</kbd>
						</label>
						<label class="kit-select-wrap">
							<Icon name="material-symbols:swap-vert-rounded" />
							<select class="kit-select" data-sort aria-label="排序">
								<option value="auto" selected>推荐</option>
								<option value="date">最新</option>
								<option value="rating">评分</option>
								<option value="title">名称</option>
							</select>
						</label>
						<div class="kit-tabs" data-tabs role="group" aria-label="视图">
							<button type="button" class="kit-tabs__item" data-view="cards" aria-pressed="true" title="卡片">
								<Icon name="material-symbols:grid-view-outline-rounded" />
							</button>
							<button type="button" class="kit-tabs__item" data-view="list" aria-pressed="false" title="列表">
								<Icon name="material-symbols:view-list-outline-rounded" />
							</button>
						</div>
					</div>
				</div>
			</div>

			<div class="wrap">
				<div class="db__facets">
					<button type="button" class="chip is-active-tag" data-active-tag hidden title="取消这个标签">
						<Icon name="material-symbols:tag-rounded" />
						<span data-tag-out></span>
						<Icon name="material-symbols:close" />
					</button>
					{
						facets.map((f) => (
							<>
								<span class="db__facet-label" data-scope={f.kind} hidden>
									{f.label}
								</span>
								<button type="button" class="chip" data-scope={f.kind} data-filter-cat="" aria-pressed="true" hidden>
									全部
								</button>
								{f.values.map(([v, n]) => (
									<button type="button" class="chip" data-scope={f.kind} data-filter-cat={v} aria-pressed="false" hidden>
										{v}
										<small>{n}</small>
									</button>
								))}
							</>
						))
					}
				</div>

				<!-- ========== 总览 ========== -->
				<div class="mag" data-overview>

					{
						layout.map((row) => (
							<div class="mag__row">
								{row.map((b) => (
									<section class="sec" style={`--span: ${b.span}`}>
										<header class="sec__head">
											<div>
												<h2>
													{b.k}
													<small>{stat(b.k)}</small>
												</h2>
												<p>{b.desc}</p>
											</div>
											<button type="button" class="sec__more" data-filter-kind={b.k}>
												全部
												<Icon name="material-symbols:arrow-forward-rounded" />
											</button>
										</header>
										<div
											class:list={["sec__grid", `is-${KIND_META[b.k].variant}`, b.feature && "has-feature"]}
											style={`--cols: ${b.cols}`}
										>
											{ofKind(b.k)
												.slice(0, b.n)
												.map((r, n) => (
													<BaseCard row={r} index={n} engine={false} feature={b.feature && n === 0} />
												))}
										</div>
									</section>
								))}
							</div>
						))
					}
				</div>

				<!-- ========== 某个类型的完整网格 ========== -->
				<div class="kit-grid db__grid" data-items hidden>
					{rows.map((r, i) => <BaseCard row={r} index={i} />)}
				</div>
			</div>
		</section>

		<section class="about" id="about" data-reveal>
			<div class="about__avatar"><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" /></div>
			<div class="about__name">{profileConfig.name}</div>
			<p class="about__bio">{profileConfig.bio}</p>
			<div class="about__links">
				{
					profileConfig.links.map((l) => (
						<a href={l.url} target="_blank" rel="noopener noreferrer">
							<Icon name={l.icon} />
							{l.name}
						</a>
					))
				}
				<a href="/about/"><Icon name="material-symbols:person-outline-rounded" />更多关于我</a>
			</div>
		</section>

		<footer class="foot">© {new Date().getFullYear()} {profileConfig.name} · {siteConfig.title}</footer>
	</div>
	<PreviewSwitch current="b" />
</Layout>

<style>
	.pb {
		--serif: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
		--db-bg: color-mix(in oklch, var(--card-bg) 94%, #a08a66);
		--db-card: color-mix(in oklch, var(--card-bg) 99%, #a08a66);
		--db-sunk: color-mix(in oklch, var(--card-bg) 88%, #a08a66);
		--db-text: rgb(34 30 28);
		--db-soft: rgb(88 82 78);
		--db-muted: rgb(146 140 134);
		--db-line: rgb(60 45 30 / 0.09);
		background: var(--db-bg);
		color: var(--db-text);
		min-height: 100vh;
	}

	:global(:root.dark) .pb {
		--db-bg: color-mix(in oklch, var(--card-bg) 78%, black);
		--db-card: color-mix(in oklch, var(--card-bg) 90%, black);
		--db-sunk: color-mix(in oklch, var(--card-bg) 70%, black);
		--db-text: rgb(240 236 232);
		--db-soft: rgb(200 194 188);
		--db-muted: rgb(140 134 128);
		--db-line: rgb(255 255 255 / 0.08);
	}

	.wrap {
		max-width: 88rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 3vw, 2.5rem);
	}

	/* 顶栏：浮在首屏上 */
	.nav {
		position: absolute;
		z-index: 10;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.25rem clamp(1rem, 3vw, 2.5rem);
		color: white;
	}

	.nav__logo {
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	.nav__links {
		margin-left: auto;
		display: flex;
		gap: 1.75rem;
		font-size: 0.9rem;
		font-weight: 600;
		opacity: 0.9;
	}

	.nav__theme :global(button) {
		color: white;
	}

	/* ---------- 首屏 ---------- */
	.hero {
		position: relative;
		height: clamp(20rem, 44vh, 28rem);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		isolation: isolate;
		color: white;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 32%;
		z-index: -2;
	}

	.hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(to top, rgb(14 12 20 / 0.78), rgb(14 12 20 / 0.12) 55%, rgb(14 12 20 / 0.3)),
			linear-gradient(to right, rgb(14 12 20 / 0.35), transparent 60%);
	}

	.hero__inner {
		width: 100%;
		max-width: 88rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 3vw, 2.5rem) 2.25rem;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}

	.hero__id {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.hero__avatar {
		width: 5rem;
		height: 5rem;
		flex: none;
		border-radius: 999px;
		overflow: hidden;
		box-shadow:
			0 0 0 3px rgb(255 255 255 / 0.85),
			0 16px 36px -14px rgb(0 0 0 / 0.6);
	}

	.hero__title {
		font-family: var(--serif);
		font-size: clamp(2.2rem, 4.2vw, 3.4rem);
		font-weight: 900;
		letter-spacing: 0.06em;
		line-height: 1.1;
		text-shadow: 0 4px 30px rgb(0 0 0 / 0.35);
	}

	.hero__sub {
		margin-top: 0.5rem;
		font-size: 0.95rem;
		letter-spacing: 0.25em;
		opacity: 0.85;
	}

	.hero__stats {
		display: flex;
		gap: 2.25rem;
	}

	.hero__stats div {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.hero__stats dd {
		font-family: var(--serif);
		font-size: 1.9rem;
		font-weight: 700;
		line-height: 1;
	}

	.hero__stats dt {
		margin-top: 0.35rem;
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		opacity: 0.75;
	}

	/* ---------- 类型标签栏 ---------- */
	.db__bar {
		position: sticky;
		top: 0;
		z-index: 6;
		background: color-mix(in oklch, var(--db-bg) 85%, transparent);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		backdrop-filter: blur(16px) saturate(1.4);
		border-bottom: 1px solid var(--db-line);
	}

	.db__bar-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1rem;
	}

	.vtabs {
		padding: 0;
		background: none;
		border-radius: 0;
		gap: 0.25rem;
		overflow-x: auto;
		scrollbar-width: none;
		max-width: 100%;
	}

	.vtabs .kit-tabs__item {
		height: 3.4rem;
		gap: 0.3rem;
		padding: 0 0.75rem;
		border-radius: 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--db-muted);
		transition: color 0.2s;
	}

	.vtabs .kit-tabs__item small {
		font-family: var(--kit-num);
		font-size: 0.68rem;
		font-weight: 600;
		opacity: 0.75;
	}

	.vtabs .kit-tabs__item:hover,
	.vtabs .kit-tabs__item[aria-pressed="true"] {
		color: var(--db-text);
	}

	.vtabs :global(.kit-tabs__ind) {
		top: auto;
		bottom: -1px;
		height: 2px;
		border-radius: 2px;
		background: var(--db-text);
	}

	.db__tools {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0;
	}

	.db__tools .kit-input,
	.db__tools .kit-select,
	.db__tools .kit-tabs {
		background: var(--db-card);
		box-shadow: 0 0 0 1px var(--db-line);
	}

	.db__tools .kit-input {
		width: 12rem;
		padding-right: 2rem;
	}

	.db__tools :global(.kit-tabs .kit-tabs__ind) {
		background: var(--db-text);
	}

	.db__tools .kit-tabs__item[aria-pressed="true"] {
		color: var(--db-bg);
	}

	.db__kbd {
		position: absolute;
		right: 0.5rem;
		display: grid;
		place-items: center;
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 0.3rem;
		font-family: var(--kit-num);
		font-size: 0.7rem;
		color: var(--db-muted);
		border: 1px solid var(--db-line);
		pointer-events: none;
		transition: opacity 0.15s;
	}

	.kit-search:focus-within .db__kbd {
		opacity: 0;
	}

	/* 第二排分类 */
	.db__facets {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		padding: 1.25rem 0 0;
	}

	.db__facets:not(:has(.chip:not([hidden]))) {
		display: none;
	}

	.db__facet-label {
		margin-right: 0.35rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--db-muted);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 1.9rem;
		padding: 0 0.85rem;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--db-soft);
		background: var(--db-card);
		box-shadow: 0 0 0 1px var(--db-line);
		transition:
			color 0.15s,
			background 0.15s;
	}

	.chip small {
		font-family: var(--kit-num);
		font-size: 0.7rem;
		opacity: 0.6;
	}

	.chip:hover {
		color: var(--db-text);
	}

	.chip[aria-pressed="true"] {
		color: var(--db-bg);
		background: var(--db-text);
		box-shadow: none;
	}

	.chip.is-active-tag {
		color: white;
		background: var(--primary);
		box-shadow: none;
		padding: 0 0.55rem 0 0.6rem;
	}

	.chip[hidden],
	.db__facet-label[hidden] {
		display: none;
	}

	/* ---------- 总览 ---------- */
	.mag {
		padding: 2.5rem 0 1rem;
	}

	/* 每一排：12 栏，类型块按 --span 占位 */
	.mag__row {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1.5rem 3rem;
		margin-top: 3.5rem;
	}

	.mag__row:first-child {
		margin-top: 0;
	}

	.sec {
		grid-column: span var(--span);
		min-width: 0;
	}

	.sec__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.sec__head h2 {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--serif);
		font-size: 1.65rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		line-height: 1.2;
	}

	.sec__head h2 small {
		font-family: var(--kit-num);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--db-muted);
	}

	.sec__head p {
		margin-top: 0.3rem;
		font-size: 0.82rem;
		color: var(--db-muted);
	}

	.sec__more {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		white-space: nowrap;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--db-muted);
		transition:
			color 0.15s,
			gap 0.3s var(--kit-spring);
	}

	.sec__more:hover {
		color: var(--db-text);
		gap: 0.4rem;
	}

	.sec__grid {
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: 1.5rem 1.1rem;
	}

	.sec__grid.is-month {
		gap: 1rem;
	}

	.sec__grid.has-feature > :global(.is-feature) {
		grid-column: span 2;
	}

	/* 收集是列表行：行间不留空，靠细线分隔 */
	.sec__grid.is-line {
		gap: 0 2.5rem;
	}

	/* ---------- 某个类型的完整网格：12 栏，海报 / 人像占 2 栏，文字 / 截图卡占 4 栏 ---------- */
	.db__grid {
		gap: 1.75rem 1.1rem;
	}

	.db__grid:not(.is-list) {
		grid-template-columns: repeat(12, minmax(0, 1fr));
	}

	.db__grid:not(.is-list) > :global(.bc-cell) {
		grid-column: span 2;
	}

	.db__grid:not(.is-list) > :global(.is-text),
	.db__grid:not(.is-list) > :global(.is-shot),
	.db__grid:not(.is-list) > :global(.is-month),
	.db__grid:not(.is-list) > :global(.is-line) {
		grid-column: span 4;
	}

	/* 收集是列表行，靠细线分隔，不要行距 */
	.db[data-active-kind="收集"] .db__grid:not(.is-list) {
		row-gap: 0;
		column-gap: 2.5rem;
	}

	.db__grid.is-list {
		gap: 0.5rem;
	}

	.db__grid[data-items] {
		padding: 1.75rem 0 3rem;
	}

	.db__grid :global(.kit-group-head) {
