---
// 方案 B 的阅读页：顶栏带类型入口；标题下面是 Obsidian 式的「笔记属性」面板，
// 分类 / 标签点了直接回到数据库筛好；动画 / 漫画 / 小说 / 游戏 / 人物用 海报（头像）+ 属性 的条目版式，
// 正文后面是双链关联（这篇提到的 / 提到这里的），文末是相关笔记卡片
import { Icon } from "astro-icon/components";
import Cover from "../../../components/kit/Cover.astro";
import LightDarkSwitch from "../../../components/LightDarkSwitch.svelte";
import Markdown from "../../../components/misc/Markdown.astro";
import BaseCard from "../../../components/preview/BaseCard.astro";
import PreviewSwitch from "../../../components/preview/PreviewSwitch.astro";
import { BASE_KINDS, type BaseProp, getProtoArticlePaths, type ProtoArticle } from "../../../components/preview/proto";
import { siteConfig } from "../../../config";
import Layout from "../../../layouts/Layout.astro";
// 主题的全局样式（颜色变量、正文排版）原本是靠 ImageWrapper 里 import.meta.glob("../../**") 顺带引进来的，
// 这页没用 ImageWrapper，所以显式引入
import "../../../styles/variables.styl";
import "../../../styles/main.css";
import "../../../styles/markdown.css";
import "../../../styles/markdown-extend.styl";

export async function getStaticPaths() {
	return getProtoArticlePaths("b");
}

const { row, related, linked, prev, next } = Astro.props as ProtoArticle;
const { Content, headings, remarkPluginFrontmatter } = await row.entry.render();
const hasBody = (row.entry.body ?? "").trim().length > 0;
const top = Math.min(...headings.map((h) => h.depth));
const toc = headings.filter((h) => h.depth <= top + 1);
const minutes = remarkPluginFrontmatter?.minutes as number | undefined;
const words = remarkPluginFrontmatter?.words as number | undefined;
const isPoster = row.variant === "poster" || row.variant === "person";
const isPerson = row.variant === "person";
// 页头大图只用文章里明确写的封面；Obsidian 笔记的图已经在正文里，不重复放
const headerImage = row.entry.collection !== "acg" && "image" in row.entry.data ? row.entry.data.image : "";

// 回到数据库并筛好
const db = (q: Record<string, string> = {}) => `/preview/b/?${new URLSearchParams({ type: row.kind, ...q })}#notes`;

// 属性面板：卡片上的属性 + 全部标签 + 字数 / 外链
const props: BaseProp[] = row.props.map((p) => (p.chips ? { ...p, chips: row.tags } : p));
if (words) props.push({ k: "字数", v: `${words} 字 · 约 ${minutes ?? 1} 分钟` });
const ICON: Record<string, string> = {
	分类: "material-symbols:folder-outline",
	类别: "material-symbols:folder-outline",
	文件标签: "material-symbols:tag-rounded",
	date: "material-symbols:calendar-today-outline-rounded",
	年份: "material-symbols:calendar-today-outline-rounded",
	月份: "material-symbols:calendar-month-outline-rounded",
	评分: "material-symbols:star-rounded",
	字数: "material-symbols:notes-rounded",
	分区: "material-symbols:inventory-2-outline-rounded",
	更新: "material-symbols:schedule-outline-rounded",
};
const relatedTitle = row.cat && related.some((r) => r.cat === row.cat) ? `同在「${row.cat}」` : `更多${row.kind}`;
---

<Layout title={row.title} description={row.excerpt}>
	<div class="rb" data-no-swup>
		<header class="bar">
			<a href="/preview/b/" class="bar__logo">{siteConfig.title}</a>
			<nav class="bar__kinds" aria-label="类型">
				{
					BASE_KINDS.map((k) => (
						<a href={`/preview/b/?type=${k}#notes`} class:list={[k === row.kind && "is-on"]}>
							{k}
						</a>
					))
				}
			</nav>
			<LightDarkSwitch client:only="svelte" />
		</header>

		<!-- 面包屑：笔记 / 类型 / 分类，每一级都能回到数据库 -->
		{
			isPoster ? (
				<section class="anime">
					{row.cover && <div class="anime__backdrop" style={`background-image: url("${row.cover}")`} />}
					<div class="anime__inner">
						<nav class="crumbs" aria-label="位置">
							<a href="/preview/b/#notes">笔记</a>
							<span>/</span>
							<a href={db()}>{row.kind}</a>
							{row.cat && (
								<>
									<span>/</span>
									<a href={db({ cat: row.cat })}>{row.cat}</a>
								</>
							)}
						</nav>
						<div class="anime__main">
							<div class:list={["anime__poster", isPerson && "is-round"]}>
								<Cover src={row.cover} title={row.title} aspect={isPerson ? "1 / 1" : "3 / 4"} eager />
							</div>
							<div class="anime__info">
								<h1 class="title">{row.title}</h1>
								{typeof row.rating === "number" && (
									<div class="score">
										<b>{row.rating.toFixed(1)}</b>
										<span class="score__max">/ 10</span>
										<span class="score__bar" style={`--p: ${row.rating * 10}%`} />
									</div>
								)}
								<dl class="props">
									<div class="props__head">笔记属性</div>
									{props
										.filter((p) => p.k !== "评分")
										.map((p) => (
											<div class="props__row">
												<dt>
													<Icon name={ICON[p.k] ?? "material-symbols:label-outline"} />
													{p.k}
												</dt>
												<dd>
													{p.chips ? (
														p.chips.length ? (
															p.chips.map((c) => (
																<a class="props__chip" href={db({ tag: c })}>
																	{c}
																</a>
															))
														) : (
															<span class="props__empty">空</span>
														)
													) : p.filter === "cat" ? (
														<a class="props__chip is-cat" href={db({ cat: row.cat })}>
															{p.v}
														</a>
													) : (
														<span class="props__v">{p.v || "—"}</span>
													)}
												</dd>
											</div>
										))}
								</dl>
								{row.link && (
									<a class="ext" href={row.link} target="_blank" rel="noopener noreferrer">
										<Icon name="material-symbols:open-in-new-rounded" />
										在 Bangumi 查看
									</a>
								)}
							</div>
						</div>
						{row.excerpt && !hasBody && <p class="anime__summary">{row.excerpt}</p>}
						{hasBody && (
							<Markdown class="markdown-content anime__body">
								<Content />
							</Markdown>
						)}
					</div>
				</section>
			) : (
				<div class="layout">
					<article class="article">
						<nav class="crumbs" aria-label="位置">
							<a href="/preview/b/#notes">笔记</a>
							<span>/</span>
							<a href={db()}>{row.kind}</a>
							{row.cat && row.cat !== row.kind && (
								<>
									<span>/</span>
									<a href={db({ cat: row.cat })}>{row.cat}</a>
								</>
							)}
						</nav>
						<h1 class="title">{row.title}</h1>
						{row.excerpt && <p class="lead">{row.excerpt}</p>}

						<dl class="props">
							<div class="props__head">笔记属性</div>
							{props.map((p) => (
								<div class="props__row">
									<dt>
										<Icon name={ICON[p.k] ?? "material-symbols:label-outline"} />
										{p.k}
									</dt>
									<dd>
										{p.chips ? (
											p.chips.length ? (
												p.chips.map((c) => (
													<a class="props__chip" href={db({ tag: c })}>
														{c}
													</a>
												))
											) : (
												<span class="props__empty">空</span>
											)
										) : p.filter === "cat" ? (
											<a class="props__chip is-cat" href={db({ cat: p.v ?? "" })}>
												{p.v}
											</a>
										) : (
											<span class="props__v">{p.v || "—"}</span>
										)}
									</dd>
								</div>
							))}
						</dl>

						{headerImage && <img class="cover" src={headerImage} alt="" referrerpolicy="no-referrer" />}

						<Markdown class="markdown-content body">
							<Content />
						</Markdown>

						{row.link && (
							<a class="ext" href={row.link} target="_blank" rel="noopener noreferrer">
								<Icon name="material-symbols:open-in-new-rounded" />
								查看项目
							</a>
						)}

						<nav class="pager" aria-label="同类型的上一篇 / 下一篇">
							{prev ? (
								<a href={prev.href} class="pager__item">
									<small>
										<Icon name="material-symbols:arrow-back-rounded" />
										较新的{row.kind}
									</small>
									<span>{prev.title}</span>
								</a>
							) : (
								<span />
							)}
							{next && (
								<a href={next.href} class="pager__item is-next">
									<small>
										较早的{row.kind}
										<Icon name="material-symbols:arrow-forward-rounded" />
									</small>
									<span>{next.title}</span>
								</a>
							)}
						</nav>
					</article>

					{toc.length > 1 && (
						<aside class="toc">
							<div class="toc__head">目录</div>
							<nav data-toc>
								{toc.map((h) => (
									<a
										href={`#${h.slug}`}
										class:list={["kit-toc__link", h.depth > top && "is-sub"]}
										data-toc-target={h.slug}
									>
										{h.text.replace(/#$/, "")}
									</a>
								))}
							</nav>
						</aside>
					)}
				</div>
			)
		}

		{
			linked.length > 0 && (
				<section class="linked">
					<h2>
						<Icon name="material-symbols:hub-outline" />
						双链关联<small>{linked.length}</small>
					</h2>
					<div class="linked__list">
						{linked.map(({ row: r, dir }) => (
							<a href={r.href} class="lk">
								<span class:list={["lk__pic", r.variant === "person" && "is-round", !r.cover && "is-empty"]}>
									{r.cover ? <img src={r.cover} alt="" loading="lazy" referrerpolicy="no-referrer" /> : [...r.title][0]}
								</span>
								<span class="lk__text">
									<b>{r.title}</b>
									<small>
										{r.kind}
										{r.cat && ` · ${r.cat}`} · {dir}
									</small>
								</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		{
			related.length > 0 && (
				<section class="related">
					<div class="related__inner">
						<div class="related__head">
							<h2>{relatedTitle}</h2>
							<a href={db(row.cat ? { cat: row.cat } : {})}>
								在数据库里看全部
								<Icon name="material-symbols:arrow-forward-rounded" />
							</a>
						</div>
						<div class:list={["kit-grid", "related__grid", isPoster && "is-posters"]}>
							{related.map((r, i) => (
								<BaseCard row={r} index={i} engine={false} />
							))}
						</div>
					</div>
				</section>
			)
		}
	</div>
	<PreviewSwitch current="b" />
</Layout>

<style>
	.rb {
		--db-bg: color-mix(in oklch, var(--card-bg) 96.5%, black);
		--db-card: var(--card-bg);
		--db-text: rgb(28 28 30);
		--db-soft: rgb(70 70 76);
		--db-muted: rgb(138 138 146);
		--db-line: color-mix(in oklch, var(--card-bg) 90%, black);
		--db-sunk: color-mix(in oklch, var(--card-bg) 92%, black);
		background: var(--db-card);
		color: var(--db-text);
		min-height: 100vh;
	}

	:global(:root.dark) .rb {
		--db-bg: color-mix(in oklch, var(--card-bg) 82%, black);
		--db-text: rgb(238 238 240);
		--db-soft: rgb(205 205 210);
		--db-muted: rgb(145 145 152);
		--db-line: color-mix(in oklch, var(--card-bg) 86%, white);
	}

	/* 顶栏：站名 + 类型入口 */
	.bar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 2rem;
		height: 3.5rem;
		padding: 0 clamp(1.25rem, 4vw, 3rem);
		background: color-mix(in oklch, var(--db-card) 86%, transparent);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom: 1px solid var(--db-line);
	}

	.bar__logo {
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	.bar__kinds {
		margin-left: auto;
		display: flex;
		height: 100%;
		gap: 0.25rem;
	}

	.bar__kinds a {
		position: relative;
		display: flex;
		align-items: center;
		padding: 0 0.8rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--db-muted);
		transition: color 0.15s;
	}

	.bar__kinds a:hover,
	.bar__kinds a.is-on {
		color: var(--db-text);
	}

	.bar__kinds a.is-on::after {
		content: "";
		position: absolute;
		left: 0.8rem;
		right: 0.8rem;
		bottom: -1px;
		height: 2.5px;
		border-radius: 2px;
		background: var(--primary);
	}

	.crumbs {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--db-muted);
	}

	.crumbs a:hover {
		color: var(--primary);
	}

	.crumbs a:last-child {
		color: var(--db-soft);
		font-weight: 600;
	}

	/* ---------- 正文版式 ---------- */
	.layout {
		display: grid;
		grid-template-columns: minmax(1.25rem, 1fr) minmax(0, 44rem) minmax(1.25rem, 1fr);
	}

	.article {
		grid-column: 2;
		padding: 2.25rem 0 4rem;
		min-width: 0;
	}

	.title {
		margin-top: 1.1rem;
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		font-weight: 900;
		line-height: 1.3;
		letter-spacing: 0.02em;
	}

	.lead {
		margin-top: 0.9rem;
		font-size: 1.08rem;
		line-height: 1.8;
		color: var(--db-muted);
	}

	/* 笔记属性：照 Obsidian 的属性面板，左边图标 + 属性名，右边值 */
	.props {
		margin-top: 1.75rem;
		padding: 0.4rem 0;
		border-top: 1px solid var(--db-line);
		border-bottom: 1px solid var(--db-line);
	}

	.props__head {
		padding: 0.5rem 0 0.35rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--db-muted);
	}

	.props__row {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		align-items: center;
		min-height: 2.25rem;
		border-radius: 0.4rem;
		transition: background 0.15s;
	}

	.props__row:hover {
		background: var(--db-bg);
	}

	.props__row dt {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding-left: 0.35rem;
		font-size: 0.85rem;
		color: var(--db-muted);
	}

	.props__row dt :global(svg) {
		font-size: 1rem;
		flex: none;
	}

	.props__row dd {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem;
		padding: 0.3rem 0.35rem;
		font-size: 0.9rem;
	}

	.props__v {
		font-family: var(--kit-num);
		color: var(--db-soft);
	}

	.props__empty {
		color: var(--db-muted);
		font-size: 0.85rem;
	}

	.props__chip {
		padding: 0.1rem 0.55rem;
		border-radius: 0.4rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 80%, var(--db-text));
		background: color-mix(in oklch, var(--db-card) 86%, var(--primary));
		transition:
			color 0.15s,
			background 0.15s;
	}

	.props__chip.is-cat {
		color: var(--db-text);
		background: var(--db-bg);
		border: 1px solid var(--db-line);
	}

	.props__chip:hover {
		color: white;
		background: var(--primary);
	}

	.cover {
		margin-top: 2rem;
		width: 100%;
		max-height: 26rem;
		object-fit: cover;
		object-position: top;
		border-radius: 1rem;
		border: 1px solid var(--db-line);
	}

	.article :global(.body) {
		margin-top: 2rem;
	}

	.ext {
		margin-top: 2rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.4rem;
		padding: 0 1.1rem;
		border-radius: 0.6rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: white;
		background: var(--primary);
		transition: filter 0.15s;
	}

	.ext:hover {
		filter: brightness(1.08);
	}

	.pager {
		margin-top: 3rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.pager__item {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
		padding: 1rem 1.25rem;
		border-radius: 0.9rem;
		border: 1px solid var(--db-line);
		transition:
			border-color 0.15s,
			transform 0.4s var(--kit-spring);
	}

	.pager__item:hover {
		border-color: var(--primary);
		transform: translateY(-2px);
	}

	.pager__item small {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.75rem;
		color: var(--db-muted);
	}

	.pager__item span {
		font-weight: 700;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.pager__item.is-next {
		grid-column: 2;
		text-align: right;
		align-items: flex-end;
	}

	.toc {
		display: none;
	}

	@media (min-width: 1280px) {
		.toc {
			display: block;
			grid-column: 3;
			position: sticky;
			top: 5rem;
			align-self: start;
			max-width: 15rem;
			margin: 7.5rem 0 0 2.5rem;
		}

		.toc__head {
			margin-bottom: 0.5rem;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			color: var(--db-muted);
		}
	}

	/* ---------- 动漫详情 ---------- */
	.anime {
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	/* 海报放大模糊当背景，往下渐隐到页面底色 */
	.anime__backdrop {
		position: absolute;
		inset: -3rem -3rem auto;
		height: 30rem;
		z-index: -1;
		background-size: cover;
		background-position: center 25%;
		filter: blur(48px) saturate(1.3);
		opacity: 0.45;
		-webkit-mask-image: linear-gradient(to bottom, black 30%, transparent);
		mask-image: linear-gradient(to bottom, black 30%, transparent);
	}

	.anime__inner {
		max-width: 60rem;
		margin: 0 auto;
		padding: 2.25rem clamp(1.25rem, 4vw, 2rem) 3rem;
	}

	.anime__main {
		margin-top: 1.5rem;
		display: grid;
		grid-template-columns: 15rem minmax(0, 1fr);
		gap: 2.5rem;
		align-items: start;
	}

	.anime__poster :global(.kit-cover) {
		border-radius: 0.9rem;
		box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.55);
	}

	.anime__info .title {
		margin-top: 0.25rem;
	}

	.score {
		margin-top: 1rem;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}

	.score b {
		font-family: var(--kit-num);
		font-size: 2.4rem;
		font-weight: 900;
		line-height: 1;
		color: var(--primary);
	}

	.score__max {
		font-family: var(--kit-num);
		font-size: 0.95rem;
		color: var(--db-muted);
	}

	.score__bar {
		align-self: center;
		margin-left: 0.75rem;
		width: 8rem;
		height: 0.4rem;
		border-radius: 999px;
		background: linear-gradient(to right, var(--primary) var(--p), var(--db-line) var(--p));
	}

	.anime__info .props {
		margin-top: 1.25rem;
	}

	.anime__summary {
		margin-top: 2rem;
		font-size: 1rem;
		line-height: 1.9;
		color: var(--db-soft);
	}

	.anime__inner :global(.anime__body) {
		margin-top: 2rem;
	}

	/* ---------- 相关笔记：灰底一整条，卡片和首页数据库一样 ---------- */
	.related {
		background: var(--db-bg);
		border-top: 1px solid var(--db-line);
	}

	.related__inner {
		max-width: 76rem;
		margin: 0 auto;
