---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PostPage from "../components/PostPage.astro";

const portfolioArticles = await getCollection(
	"portfolio",
	({ data }) => data.draft !== true,
);

// 按发布日期降序排列（新的在上，旧的在下）
portfolioArticles.sort((a, b) => {
	return (
		new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
	);
});

const page = {
	data: portfolioArticles,
	url: {
		current: "/portfolio",
		prev: undefined,
		next: undefined,
	},
	start: 0,
	end: portfolioArticles.length - 1,
	size: portfolioArticles.length,
	total: portfolioArticles.length,
	currentPage: 1,
	lastPage: 1,
};
---

<MainGridLayout banner={undefined} title="项目">
	<PostPage page={page}></PostPage>
</MainGridLayout>
