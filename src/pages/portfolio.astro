---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PostPage from "../components/PostPage.astro";

// 获取portfolio collection中的文章
const portfolioArticles = await getCollection("portfolio", ({ data }) => data.draft !== true);

// 构造与主页相同的 page 对象结构
const page = {
	data: portfolioArticles,
	url: {
		current: "/portfolio",
		prev: undefined,
		next: undefined,
	},
	start: 0,
	end: portfolioArticles.length - 1,
	size: portfolioArticles.length,
	total: portfolioArticles.length,
	currentPage: 1,
	lastPage: 1,
};
---

<MainGridLayout banner={undefined} title="作品集">
    <PostPage page={page}></PostPage>
</MainGridLayout>
