---
import { Icon } from "astro-icon/components";
import JournalNav from "../../components/kit/JournalNav.astro";
import KitShell from "../../components/kit/KitShell.astro";
import LibraryCard from "../../components/kit/LibraryCard.astro";
import StatStrip from "../../components/kit/StatStrip.astro";
import WorkCard from "../../components/kit/WorkCard.astro";
import Markdown from "../../components/misc/Markdown.astro";
import { shelves } from "../../data/shelves";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getMonthDigests, type MonthDigest } from "../../utils/kit/content";

export async function getStaticPaths() {
	const digests = await getMonthDigests();
	return digests.map((d, i) => ({
		params: { month: d.month },
		// digests 是倒序的：前一项是更新的月份
		props: { d, digests, newer: digests[i - 1], older: digests[i + 1] },
	}));
}

const { d, digests, newer, older } = Astro.props as {
	d: MonthDigest;
	digests: MonthDigest[];
	newer?: MonthDigest;
	older?: MonthDigest;
};
const Content = d.note ? (await d.note.render()).Content : null;
const monthLabel = String(d.monthNumber).padStart(2, "0");
const heading = d.title || `${d.year} 年 ${d.monthNumber} 月`;
const label = (m: MonthDigest) => m.title || `${m.year} 年 ${m.monthNumber} 月`;

const stats = [
	{ label: "写了", value: d.stats.writings, unit: "篇" },
	{ label: "新作品", value: d.stats.works, unit: "个" },
	{ label: "收录", value: d.stats.library, unit: "条" },
	...(d.stats.avgRating ? [{ label: "收录均分", value: d.stats.avgRating, decimals: 1 }] : []),
];

// 本月收录按书架分组，不同书架的封面比例不同
const libraryByShelf = shelves
	.map((shelf) => ({ shelf, items: d.library.filter((i) => i.shelf.id === shelf.id) }))
	.filter((g) => g.items.length > 0);

const KIND_LABEL = { post: "文章", resource: "资源", work: "作品" } as const;
const fmt = (date: Date) => date.toISOString().slice(5, 10);
// 「自动 / 手写」标记和空月记提示只在本地开发时显示
const isDev = import.meta.env.DEV;
---

<MainGridLayout title={`${heading} · 月记`} description={d.summary || `${d.year} 年 ${d.monthNumber} 月的记录`}>
	<KitShell>
		<JournalNav slot="side" digests={digests} current={d.month} />

		<header class="card-base kit-head mhead onload-animation">
			<div class="mhead__num" data-split>{monthLabel}</div>
			<div class="mhead__info">
				<nav class="kit-crumb text-50" aria-label="面包屑">
					<a href="/journal/">月记</a><span class="opacity-50">/</span><span>{d.year}</span>
				</nav>
				<h1 class="kit-head__title text-90">{heading}</h1>
				{d.summary && <p class="kit-head__desc text-75">{d.summary}</p>}
			</div>
			<div class="mhead__stats"><StatStrip stats={stats} /></div>
			{d.cover && <img class="mhead__cover" src={d.cover} alt="" referrerpolicy="no-referrer" />}
		</header>

		{
			d.works.length > 0 && (
				<section data-reveal>
					<h2 class="kit-section-title text-90">
						本月作品 <small class="text-50">{d.works.length}</small>
						{isDev && <span class="dev-chip">自动</span>}
					</h2>
					<div class="flex flex-col gap-4">
						{d.works.map((w, i) => <WorkCard work={w} index={i} featured={d.works.length === 1} />)}
					</div>
				</section>
			)
		}

		{
			d.writings.length > 0 && (
				<section class="card-base kit-section" data-reveal>
					<h2 class="kit-section-title text-90">
						本月写了 <small class="text-50">{d.writings.length}</small>
						{isDev && <span class="dev-chip">自动</span>}
					</h2>
					<div class="kit-rows">
						{d.writings.map((w) => (
							<a class="kit-row" href={w.url}>
								{w.cover ? <img class="kit-row__thumb" src={w.cover} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="kit-row__thumb" />}
								<span class="kit-row__title text-90">
									{w.title}
									{w.description && <small class="text-50">{w.description}</small>}
								</span>
								<span class="btn-regular h-6 text-xs px-2 rounded-lg hidden sm:flex">{w.category || KIND_LABEL[w.kind]}</span>
								<span class="kit-row__date text-50">{fmt(w.date)}</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		{
			libraryByShelf.map(({ shelf, items }) => (
				<section data-reveal>
					<h2 class="kit-section-title text-90">
						本月收录 · {shelf.title} <small class="text-50">{items.length}</small>
						{isDev && <span class="dev-chip">自动</span>}
					</h2>
					<div class:list={["kit-grid", shelf.aspect !== "3 / 4" && "kit-grid--wide"]}>
						{items.map((it, i) => <LibraryCard item={it} index={i} />)}
					</div>
				</section>
			))
		}

		{
			Content ? (
				<section class="card-base kit-section" data-reveal>
					{isDev && <span class="dev-chip dev-chip--corner">手写</span>}
					<Markdown class="markdown-content">
						<Content />
					</Markdown>
				</section>
			) : (
				isDev && (
					<section class="card-base kit-section hint" data-reveal>
						<Icon name="material-symbols:edit-note-outline-rounded" class="text-3xl flex-none" />
						<div class="text-75">
							<b>这个月还没写月记。</b>
							新建 <code>src/content/journal/{d.month}.md</code>，写上 <code>month: {d.month}</code> 和几句话就行。
							<br />
							<small class="text-50">这块提示只在本地开发时显示，线上不会出现。</small>
						</div>
					</section>
				)
			)
		}

		<nav class="pager">
			{
				older ? (
					<a class="card-base pager__item" href={`/journal/${older.month}/`}>
						<small class="text-50">
							<Icon name="material-symbols:chevron-left-rounded" class="inline" /> 上个月
						</small>
						<span class="text-90">{label(older)}</span>
					</a>
				) : (
					<span />
				)
			}
			{
				newer && (
					<a class="card-base pager__item is-next" href={`/journal/${newer.month}/`}>
						<small class="text-50">
							下个月 <Icon name="material-symbols:chevron-right-rounded" class="inline" />
						</small>
						<span class="text-90">{label(newer)}</span>
					</a>
				)
			}
		</nav>
	</KitShell>
</MainGridLayout>

<style>
	.mhead {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: end;
		gap: 0.5rem 1.75rem;
	}

	.mhead__num {
		font-family: var(--kit-num);
		font-weight: 700;
		font-size: clamp(4.5rem, 12vw, 7.5rem);
		line-height: 0.85;
		letter-spacing: -0.05em;
		color: var(--primary);
	}

	/* 大号月份数字已经够醒目，标题不需要再加竖条 */
	.mhead :global(.kit-head__title)::before {
		display: none;
	}

	.mhead__stats {
		grid-column: 1 / -1;
		margin-top: 1.25rem;
	}

	.mhead__cover {
		grid-column: 1 / -1;
		margin-top: 0.75rem;
		width: 100%;
		max-height: 18rem;
		object-fit: cover;
		border-radius: 0.75rem;
	}

	.dev-chip {
		font-size: 0.6875rem;
		font-weight: 500;
		padding: 0.1rem 0.45rem;
		border-radius: 0.375rem;
		border: 1px dashed var(--btn-content);
		color: var(--btn-content);
	}

	.dev-chip--corner {
		position: absolute;
		top: 1rem;
		right: 1rem;
	}

	.hint {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		line-height: 1.8;
		color: var(--btn-content);
	}

	.hint code {
		font-size: 0.85em;
		padding: 0.1em 0.4em;
		border-radius: 0.35em;
		background: var(--btn-regular-bg);
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.pager__item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem 1.5rem;
		font-weight: 700;
		transition: transform 0.5s var(--kit-spring);
	}

	.pager__item:hover {
		transform: translateY(-3px);
	}

	.pager__item:hover span {
		color: var(--primary);
	}

	.pager__item small {
		font-weight: 500;
	}

	.pager__item.is-next {
		text-align: right;
		grid-column: 2;
	}
</style>
