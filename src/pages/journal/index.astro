---
import { Icon } from "astro-icon/components";
import JournalNav from "../../components/kit/JournalNav.astro";
import KitHeader from "../../components/kit/KitHeader.astro";
import KitShell from "../../components/kit/KitShell.astro";
import VaultHeader from "../../components/kit/VaultHeader.astro";
import VaultNav from "../../components/kit/VaultNav.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getMonthDigests, monthKey } from "../../utils/kit/content";

const digests = await getMonthDigests();
const byMonth = new Map(digests.map((d) => [d.month, d]));
const now = new Date();
const thisMonth = monthKey(now);
const thisYear = now.getUTCFullYear();
const firstYear = Math.min(...digests.map((d) => d.year), thisYear);
const years = Array.from({ length: thisYear - firstYear + 1 }, (_, i) => thisYear - i);
const written = digests.filter((d) => d.note);
const latest = written[0];

const activity = (d: (typeof digests)[number]) =>
	[
		d.stats.writings && `${d.stats.writings} 篇`,
		d.stats.works && `${d.stats.works} 作品`,
		d.stats.library && `${d.stats.library} 收录`,
	]
		.filter(Boolean)
		.join(" · ");
---

<MainGridLayout title="月记" description="每个月一页，自动汇总加几句碎碎念">
	<KitShell>
		<Fragment slot="side">
			<VaultHeader />
			<VaultNav active="journal" />
			<JournalNav digests={digests} />
		</Fragment>

		<KitHeader title="月记" />

		{
			latest && (
				<a href={`/journal/${latest.month}/`} class="card-base latest onload-animation">
					{latest.cover && <img class="latest__bg" src={latest.cover} alt="" referrerpolicy="no-referrer" />}
					<div class="latest__num">{String(latest.monthNumber).padStart(2, "0")}</div>
					<div class="latest__info">
						<div class="text-50 text-sm">
							最新一期 · {latest.year} 年 {latest.monthNumber} 月
						</div>
						<div class="latest__title text-90">{latest.title || `${latest.year} 年 ${latest.monthNumber} 月`}</div>
						{latest.summary && <p class="text-75 mt-1">{latest.summary}</p>}
						<div class="latest__meta">
							<span class="btn-regular h-7 text-xs px-2.5 rounded-lg">{activity(latest) || "只有碎碎念"}</span>
							<span class="latest__go">
								翻开 <Icon name="material-symbols:arrow-forward-rounded" />
							</span>
						</div>
					</div>
				</a>
			)
		}

		{
			years.map((year) => {
				const count = digests.filter((d) => d.year === year).length;
				return (
					<section class="card-base kit-section" data-reveal>
						<h2 class="kit-section-title text-90">
							{year} <small class="text-50">{count} 个月有记录</small>
						</h2>
						<div class="months">
							{Array.from({ length: 12 }, (_, m) => {
								const key = `${year}-${String(m + 1).padStart(2, "0")}`;
								const d = byMonth.get(key);
								const label = String(m + 1).padStart(2, "0");
								if (!d) {
									return (
										<div class:list={["month", "is-empty", key > thisMonth && "is-future"]}>
											<span class="month__num">{label}</span>
										</div>
									);
								}
								return (
									<a href={`/journal/${key}/`} class:list={["month", d.note ? "is-written" : "is-auto"]} title={d.title || activity(d)}>
										{d.note && d.cover && <img src={d.cover} alt="" loading="lazy" referrerpolicy="no-referrer" />}
										<span class="month__num">{label}</span>
										<span class="month__sub">{d.note ? d.title || "月记" : activity(d)}</span>
									</a>
								);
							})}
						</div>
					</section>
				);
			})
		}

		<p class="legend text-50">
			<span><i class="dot is-written"></i>写了月记</span>
			<span><i class="dot is-auto"></i>只有自动汇总</span>
			<span><i class="dot is-empty"></i>没有记录</span>
		</p>
	</KitShell>
</MainGridLayout>

<style>
	.latest {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 1.5rem 2.25rem;
		isolation: isolate;
		transition:
			transform 0.5s var(--kit-spring),
			box-shadow 0.4s;
	}

	.latest:hover {
		transform: translateY(-3px);
		box-shadow: var(--kit-shadow);
	}

	.latest__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.12;
		z-index: -1;
	}

	.latest__num {
		font-family: var(--kit-num);
		font-weight: 700;
		font-size: clamp(4rem, 12vw, 6.5rem);
		line-height: 0.9;
		color: var(--primary);
		letter-spacing: -0.04em;
	}

	.latest__title {
		font-size: 1.5rem;
		font-weight: 700;
		margin-top: 0.25rem;
	}

	.latest__meta {
		margin-top: 0.9rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.latest__go {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--primary);
	}

	.months {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}

	@media (min-width: 640px) {
		.months {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (min-width: 1280px) {
		.months {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
	}

	.month {
		position: relative;
		aspect-ratio: 1;
		border-radius: 0.75rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0.6rem 0.7rem;
		isolation: isolate;
		transition:
			transform 0.5s var(--kit-spring),
			box-shadow 0.4s;
	}

	a.month:hover {
		transform: translateY(-4px) scale(1.02);
		box-shadow: var(--kit-shadow);
	}

	.month__num {
		font-family: var(--kit-num);
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1;
	}

	.month__sub {
		margin-top: 0.3rem;
		font-size: 0.6875rem;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.month.is-written {
		background: var(--primary);
		color: white;
	}

	.month.is-written img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
		transition: transform 0.8s var(--kit-ease-out);
	}

	.month.is-written::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.1) 70%);
	}

	.month.is-written:hover img {
		transform: scale(1.08);
	}

	.month.is-auto {
		background: var(--btn-regular-bg);
		color: var(--btn-content);
	}

	.month.is-empty {
		border: 1.5px dashed rgb(0 0 0 / 0.12);
		color: rgb(0 0 0 / 0.3);
	}

	:global(:root.dark) .month.is-empty {
		border-color: rgb(255 255 255 / 0.15);
		color: rgb(255 255 255 / 0.3);
	}

	.month.is-future {
		opacity: 0.45;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		font-size: 0.8125rem;
		padding: 0.25rem 0 0.5rem;
	}

	.legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.dot {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 0.25rem;
	}

	.dot.is-written {
		background: var(--primary);
	}

	.dot.is-auto {
		background: var(--btn-regular-bg);
		border: 1px solid var(--btn-content);
	}

	.dot.is-empty {
		border: 1.5px dashed currentColor;
	}
</style>
