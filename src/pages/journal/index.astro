---
import { Icon } from "astro-icon/components";
import PageHero from "../../components/kit/PageHero.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getMonthDigests, monthKey } from "../../utils/kit/content";

const digests = await getMonthDigests();
const byMonth = new Map(digests.map((d) => [d.month, d]));
const now = new Date();
const thisMonth = monthKey(now);
const firstYear = Math.min(...digests.map((d) => d.year), now.getFullYear());
const years = Array.from({ length: now.getFullYear() - firstYear + 1 }, (_, i) => now.getFullYear() - i);
const written = digests.filter((d) => d.note);
const latest = written[0];

const MONTHS_EN = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const MONTHS_CN = ["一月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "十一月", "十二月"];

const activity = (d: (typeof digests)[number]) =>
	[
		d.stats.writings && `${d.stats.writings} 篇`,
		d.stats.works && `${d.stats.works} 作品`,
		d.stats.library && `${d.stats.library} 收录`,
	]
		.filter(Boolean)
		.join(" · ");
---

<MainGridLayout title="月记" description="每个月一页，自动汇总加几句碎碎念">
	<div class="kit">
		<PageHero
			eyebrow="JOURNAL · 月记"
			title="月记"
			subtitle="每个月一页：这个月写的文章、做的作品、收进收藏库的东西会自动汇总进来，只需要再写几句碎碎念。"
			kinetic={[MONTHS_EN, MONTHS_CN]}
		>
			<span><b>{written.length}</b>期手写</span>
			<span><b>{digests.length}</b>个有记录的月份</span>
		</PageHero>

		{
			latest && (
				<a href={`/journal/${latest.month}/`} class="kit-panel latest" data-reveal style="--i: 1">
					{latest.cover && <img class="latest__bg" src={latest.cover} alt="" referrerpolicy="no-referrer" />}
					<div class="latest__num">{String(latest.monthNumber).padStart(2, "0")}</div>
					<div class="latest__info">
						<div class="kit-eyebrow">最新一期 · {latest.year} 年 {latest.monthNumber} 月</div>
						<div class="latest__title">{latest.title || `${latest.year} 年 ${latest.monthNumber} 月`}</div>
						{latest.summary && <p class="kit-subtitle">{latest.summary}</p>}
						<div class="latest__meta">
							<span class="kit-chip">{activity(latest) || "只有碎碎念"}</span>
							<span class="kit-btn">
								翻开 <Icon name="material-symbols:arrow-forward-rounded" />
							</span>
						</div>
					</div>
				</a>
			)
		}

		{
			years.map((year, yi) => {
				const count = digests.filter((d) => d.year === year).length;
				return (
					<section class="kit-panel" data-reveal style={`--i: ${yi + 2}`}>
						<div class="year-head">
							<span class="year-head__num">{year}</span>
							<span class="year-head__count">{count} 个月有记录</span>
						</div>
						<div class="months">
							{Array.from({ length: 12 }, (_, m) => {
								const key = `${year}-${String(m + 1).padStart(2, "0")}`;
								const d = byMonth.get(key);
								const future = key > thisMonth;
								const label = String(m + 1).padStart(2, "0");
								if (!d) {
									return (
										<div class:list={["month", "is-empty", future && "is-future"]} data-reveal style={`--i: ${m}`}>
											<span class="month__num">{label}</span>
										</div>
									);
								}
								return (
									<a
										href={`/journal/${key}/`}
										class:list={["month", d.note ? "is-written" : "is-auto"]}
										data-reveal
										style={`--i: ${m}`}
										title={d.title || activity(d)}
									>
										{d.note && d.cover && <img src={d.cover} alt="" loading="lazy" referrerpolicy="no-referrer" />}
										<span class="month__num">{label}</span>
										<span class="month__sub">{d.note ? d.title || "月记" : activity(d)}</span>
									</a>
								);
							})}
						</div>
					</section>
				);
			})
		}

		<p class="legend" data-reveal>
			<span><i class="dot is-written"></i>写了月记</span>
			<span><i class="dot is-auto"></i>只有自动汇总</span>
			<span><i class="dot is-empty"></i>没有记录</span>
		</p>
	</div>
</MainGridLayout>

<style>
	.latest {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		color: inherit;
		isolation: isolate;
	}

	.latest__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.14;
		filter: blur(2px) saturate(1.2);
		z-index: -1;
	}

	.latest__num {
		font-family: var(--kit-num);
		font-weight: 700;
		font-size: clamp(4.5rem, 14vw, 8rem);
		line-height: 0.9;
		color: var(--primary);
		letter-spacing: -0.04em;
	}

	.latest__title {
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--kit-ink);
	}

	.latest__meta {
		margin-top: 1rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.year-head {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.year-head__num {
		font-family: var(--kit-num);
		font-size: 2rem;
		font-weight: 700;
		color: var(--kit-ink);
	}

	.year-head__count {
		font-size: 0.875rem;
		color: var(--kit-ink-3);
	}

	.months {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}

	@media (min-width: 640px) {
		.months {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.months {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
	}

	.month {
		position: relative;
		aspect-ratio: 1;
		border-radius: 0.9rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0.6rem 0.7rem;
		isolation: isolate;
		transition:
			transform 0.5s var(--kit-spring),
			box-shadow 0.4s;
	}

	a.month:hover {
		transform: translateY(-4px) scale(1.02);
		box-shadow: var(--kit-shadow);
	}

	.month__num {
		font-family: var(--kit-num);
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1;
	}

	.month__sub {
		margin-top: 0.3rem;
		font-size: 0.6875rem;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.month.is-written {
		background: var(--primary);
		color: white;
	}

	.month.is-written img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
		transition: transform 0.8s var(--kit-ease-out);
	}

	.month.is-written::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.1) 70%);
	}

	.month.is-written:hover img {
		transform: scale(1.08);
	}

	.month.is-auto {
		background: var(--kit-soft);
		color: color-mix(in oklch, var(--primary) 75%, var(--kit-ink));
	}

	.month.is-empty {
		border: 1.5px dashed var(--kit-line);
		color: var(--kit-ink-3);
	}

	.month.is-future {
		opacity: 0.4;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		font-size: 0.8125rem;
		color: var(--kit-ink-3);
		padding: 0.5rem 0 1rem;
	}

	.legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.dot {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 0.25rem;
	}

	.dot.is-written {
		background: var(--primary);
	}

	.dot.is-auto {
		background: var(--kit-soft-2);
	}

	.dot.is-empty {
		border: 1.5px dashed var(--kit-ink-3);
	}
</style>
