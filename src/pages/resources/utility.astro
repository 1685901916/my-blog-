---
import { getCollection } from "astro:content";
import PostCard from "@components/PostCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { sidebarLayoutConfig, siteConfig } from "../../config";

// 获取所有分类为"实用工具"的文章
const allPosts = await getCollection("posts", ({ data }) => data.draft !== true);

const utilityPosts = allPosts
	.filter((post) => post.data.category === "实用工具")
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const isBothSidebars = sidebarLayoutConfig.position === "both";
const defaultLayout = siteConfig.postListLayout.defaultMode || "list";
const initialLayoutClass =
	defaultLayout === "grid"
		? "grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-4 grid-mode"
		: "flex flex-col gap-2 md:gap-4 list-mode";

let delay = 0;
const interval = 50;
---

<MainGridLayout banner={undefined} title="实用工具">
	<div
		id="post-list-container"
		class={`transition-all duration-500 ease-in-out rounded-[var(--radius-large)] bg-[var(--card-bg)] py-0 md:py-0 md:bg-transparent mb-4 ${initialLayoutClass}`}
		data-default-layout={defaultLayout}
		data-both-sidebars={isBothSidebars}
	>
		{utilityPosts.map((entry) => (
			<PostCard
				entry={entry}
				title={entry.data.title}
				tags={entry.data.tags}
				category={entry.data.category}
				published={entry.data.published}
				updated={entry.data.updated}
				url={`/posts/${entry.slug}/`}
				image={entry.data.image}
				description={entry.data.description}
				draft={entry.data.draft}
				pinned={entry.data.pinned}
				class:list="onload-animation"
				style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
			/>
		))}

		{utilityPosts.length === 0 && (
			<div class="card-base px-8 py-12">
				<p class="text-center text-neutral-500 dark:text-neutral-400">暂无实用工具内容</p>
			</div>
		)}
	</div>
</MainGridLayout>

<script>
	function updateLayout(layout) {
		const container = document.getElementById("post-list-container");
		if (!container) return;

		container.classList.add("layout-switching");
		container.classList.remove("list-mode", "grid-mode");

		if (layout === "grid") {
			container.classList.add("grid-mode");
			container.classList.add("grid", "grid-cols-1", "md:grid-cols-2");
			container.classList.remove("flex", "flex-col");

			const rightSidebar = document.querySelector(".right-sidebar-container");
			rightSidebar?.classList.add("hidden-in-grid-mode");
			document.getElementById("main-grid")?.setAttribute("data-layout-mode", "grid");
		} else {
			container.classList.add("list-mode");
			container.classList.add("flex", "flex-col");
			container.classList.remove("grid", "grid-cols-1", "md:grid-cols-2");

			const rightSidebar = document.querySelector(".right-sidebar-container");
			rightSidebar?.classList.remove("hidden-in-grid-mode");
			document.getElementById("main-grid")?.setAttribute("data-layout-mode", "list");
		}

		setTimeout(() => container.classList.remove("layout-switching"), 500);
	}

	function initLayout() {
		setTimeout(() => {
			const container = document.getElementById("post-list-container");
			if (!container) return;
			const saved = localStorage.getItem("postListLayout");
			const defaultLayout = container.getAttribute("data-default-layout") || "list";
			const current = saved || defaultLayout;

			if (window.innerWidth >= 769) {
				updateLayout(current);
			} else {
				container.classList.add("js-initialized");
			}
		}, 50);
	}

	window.addEventListener("layoutChange", (event) => {
		const mode = event.detail?.layout;
		if (mode === "grid" || mode === "list") {
			updateLayout(mode);
		}
	});

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initLayout);
	} else {
		initLayout();
	}
</script>
