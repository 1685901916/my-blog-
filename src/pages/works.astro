---
import KitHeader from "../components/kit/KitHeader.astro";
import KitShell from "../components/kit/KitShell.astro";
import SideTags from "../components/kit/SideTags.astro";
import Toolbar from "../components/kit/Toolbar.astro";
import VaultHeader from "../components/kit/VaultHeader.astro";
import VaultNav from "../components/kit/VaultNav.astro";
import WorkCard from "../components/kit/WorkCard.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getWorks } from "../utils/kit/content";

const works = await getWorks();
const [featured, ...rest] = works;

const tagCount = new Map<string, number>();
for (const w of works) for (const t of w.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const sorted = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ name, count }));
// 「程序系 / 正常系」是作品分组，其余是技术栈
const stack = sorted.filter((t) => !t.name.endsWith("系"));
---

<MainGridLayout title="作品" description="写过的工具、做过的东西">
	<KitShell collection={{ defaultSort: "date" }}>
		<Fragment slot="side">
			<VaultHeader />
			<VaultNav active="works" />
			<SideTags id="kit-stack" title="技术栈" tags={stack} allLabel={false} />
		</Fragment>

		<KitHeader
			title="作品"
		>
			<Toolbar
				slot="toolbar"
				total={works.length}
				sorts={[
					{ value: "date", label: "日期" },
					{ value: "title", label: "标题" },
				]}
				defaultSort="date"
				groups={[{ value: "year", label: "年份" }]}
				searchPlaceholder="搜索作品或技术栈"
			/>
		</KitHeader>

		<!-- 最新作品带 data-featured：占满一行、排序时始终在最前，被筛掉时这一行自然消失 -->
		<div class="kit-grid kit-grid--wide" data-items>
			{featured && <WorkCard work={featured} featured />}
			{rest.map((w, i) => <WorkCard work={w} index={i + 1} />)}
		</div>
	</KitShell>
</MainGridLayout>
