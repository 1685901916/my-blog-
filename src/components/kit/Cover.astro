---
// 封面：有图显示图（加载时模糊淡入），没图或加载失败时显示字体封面
interface Props {
	src?: string;
	title: string;
	aspect?: string;
	eager?: boolean;
	class?: string;
}
const { src, title, aspect = "3 / 4", eager = false, class: className } = Astro.props;
const initial = [...title.replace(/^[^\p{L}\p{N}]+/u, "")][0] ?? "?";
---

<div class:list={["kit-cover", className]} style={`--aspect: ${aspect}`}>
	<!-- 字体封面：标题文字 + 首字大水印，没封面或图片加载失败时露出来 -->
	<div class="kit-cover__fallback" aria-hidden="true">
		<span class="kit-cover__mark">{initial}</span>
		<span class="kit-cover__title">{title}</span>
	</div>
	{
		src && (
			<img
				src={src}
				alt={title}
				loading={eager ? "eager" : "lazy"}
				decoding="async"
				referrerpolicy="no-referrer"
				data-loading
				style="position: relative"
			/>
		)
	}
	<slot />
</div>
