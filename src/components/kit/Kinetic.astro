---
// 背景漂移大字：每行内容重复成两半，translateX(-50%) 正好无缝循环
interface Props {
	rows: string[][];
}
const { rows } = Astro.props;
const fill = (words: string[]) => {
	const out = [...words];
	while (out.length < 8) out.push(...words);
	return [...out, ...out];
};
---

<div class="kit-kinetic" aria-hidden="true">
	{rows.map((words) => <div class="kit-kinetic__row">{fill(words).map((w) => <span>{w}</span>)}</div>)}
</div>
