---
import Kinetic from "./Kinetic.astro";

interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	kinetic?: string[][];
}
const { eyebrow, title, subtitle, kinetic } = Astro.props;
---

<section class="kit-panel kit-hero">
	{kinetic && <Kinetic rows={kinetic} />}
	<div class="kit-hero__inner">
		{eyebrow && <div class="kit-eyebrow" data-reveal>{eyebrow}</div>}
		<h1 class="kit-title" data-split>{title}</h1>
		{subtitle && <p class="kit-subtitle" data-reveal style="--i: 4">{subtitle}</p>}
		{Astro.slots.has("default") && <div class="kit-hero__meta" data-reveal style="--i: 6"><slot /></div>}
	</div>
</section>
