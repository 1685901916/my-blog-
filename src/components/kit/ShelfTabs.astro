---
import { Icon } from "astro-icon/components";
import { shelves } from "../../data/shelves";

interface Props {
	current?: string;
}
const { current } = Astro.props;
---

<nav class="kit-tabs" data-tabs aria-label="书架">
	<a class="kit-tabs__item" href="/library/" aria-current={current ? undefined : "page"}>
		<Icon name="material-symbols:collections-bookmark-outline-rounded" />全部
	</a>
	{
		shelves.map((s) => (
			<a class="kit-tabs__item" href={`/library/${s.id}/`} aria-current={current === s.id ? "page" : undefined}>
				<Icon name={s.icon} />
				{s.title}
			</a>
		))
	}
</nav>
