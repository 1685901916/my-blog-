---
// Bases 式卡片视图的外壳：工具栏 + 标签筛选 + 网格
// 卡片本身通过 slot 传进来，每张卡片外层需要 data-item 和 data-title / data-tags / data-date / data-rating
import { Icon } from "astro-icon/components";

type Option = { value: string; label: string };
interface Props {
	total: number;
	tags: Array<{ name: string; count: number }>;
	sorts: Option[];
	defaultSort: string;
	groups?: Option[];
	views?: boolean;
	wide?: boolean;
	searchPlaceholder?: string;
}
const {
	total,
	tags,
	sorts,
	defaultSort,
	groups,
	views = true,
	wide = false,
	searchPlaceholder = "搜索标题或标签",
} = Astro.props;
---

<section class="kit-panel" data-collection data-default-sort={defaultSort} data-reveal style="--i: 2">
	<div class="kit-toolbar">
		<div class="kit-toolbar__count">
			<b data-count-out>{total}</b> 个结果
		</div>
		<input class="kit-input" type="search" data-search placeholder={searchPlaceholder} aria-label="搜索" />
		<select class="kit-select" data-sort aria-label="排序">
			{sorts.map((s) => <option value={s.value} selected={s.value === defaultSort}>按{s.label}</option>)}
		</select>
		{
			groups && (
				<select class="kit-select" data-group aria-label="分组">
					<option value="">不分组</option>
					{groups.map((g) => <option value={g.value}>按{g.label}分组</option>)}
				</select>
			)
		}
		{
			views && (
				<div class="kit-tabs" data-tabs role="group" aria-label="视图">
					<button type="button" class="kit-tabs__item" data-view="cards" aria-pressed="true">
						<Icon name="material-symbols:grid-view-outline-rounded" />卡片
					</button>
					<button type="button" class="kit-tabs__item" data-view="list" aria-pressed="false">
						<Icon name="material-symbols:view-list-outline-rounded" />列表
					</button>
				</div>
			)
		}
	</div>
	{
		tags.length > 0 && (
			<div class="kit-filters" role="group" aria-label="按标签筛选">
				<button type="button" class="kit-chip" data-filter="" aria-pressed="true">全部</button>
				{tags.map((t) => (
					<button type="button" class="kit-chip" data-filter={t.name} aria-pressed="false">
						{t.name}
						<small style="opacity: .6">{t.count}</small>
					</button>
				))}
			</div>
		)
	}
	<div class:list={["kit-grid", wide && "kit-grid--wide"]} data-items style="margin-top: 1.25rem">
		<slot />
	</div>
</section>
