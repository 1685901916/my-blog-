---
// 左栏最上面的个人卡片（每个库页面都有）：头像 + 站名 + 一句话介绍 + 链接。
// 正上方就是横幅插画，这里不再重复放图；完整的自我介绍在「关于」页
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../../config";
import ImageWrapper from "../misc/ImageWrapper.astro";
---

<div class="card-base vault-head">
	<div class="vault-head__row">
		<a href="/about/" class="vault-head__avatar" aria-label="关于我">
			<ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" />
		</a>
		<div class="vault-head__text">
			<div class="vault-head__name text-90">{siteConfig.title}</div>
			<div class="vault-head__by text-50">{profileConfig.name} 的库</div>
		</div>
	</div>
	<p class="vault-head__bio text-75" title={profileConfig.bio}>{profileConfig.bio}</p>
	<div class="vault-head__links">
		{
			profileConfig.links.map((l) => (
				<a href={l.url} target="_blank" rel="noopener noreferrer" class="vault-head__link" aria-label={l.name}>
					<Icon name={l.icon} />
					{l.name}
				</a>
			))
		}
		<a href="/about/" class="vault-head__link">
			<Icon name="material-symbols:person-outline-rounded" />
			关于我
		</a>
	</div>
</div>

<style>
	.vault-head {
		padding: 1.1rem 1.15rem 0.9rem;
	}

	.vault-head__row {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	.vault-head__avatar {
		flex: none;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 0.9rem;
		overflow: hidden;
		transition: transform 0.5s var(--kit-spring);
	}

	.vault-head__avatar:hover {
		transform: rotate(-4deg) scale(1.05);
	}

	.vault-head__text {
		min-width: 0;
	}

	.vault-head__name {
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		line-height: 1.3;
	}

	.vault-head__by {
		margin-top: 0.1rem;
		font-size: 0.8125rem;
	}

	.vault-head__bio {
		margin-top: 0.8rem;
		font-size: 0.8125rem;
		line-height: 1.75;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.vault-head__links {
		margin-top: 0.7rem;
		padding-top: 0.7rem;
		border-top: 1px dashed var(--line-divider);
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}

	.vault-head__link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.8125rem;
		color: rgb(115 115 115);
		transition: color 0.15s;
	}

	.vault-head__link:hover {
		color: var(--primary);
	}

	/* 窄屏左栏在内容上方：只留头像和站名 */
	@media (max-width: 1023px) {
		.vault-head__bio,
		.vault-head__links {
			display: none;
		}
	}
</style>
