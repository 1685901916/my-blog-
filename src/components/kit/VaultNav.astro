---
// 「库」分类树：每个页面左栏都有，像 Obsidian 左边展开的文件树。
// 文章挂各分类、收藏库挂各书架、作品挂程序系 / 正常系；只展开当前所在的分组，其余收起只显示数量。
// 在文章库 / 作品墙页面里，子项直接充当筛选按钮（不跳页）；在其他页面是普通链接。
import { Icon } from "astro-icon/components";
import WidgetLayout from "../widget/WidgetLayout.astro";
import { getFeed, getMonthDigests, getShelvesWithItems } from "../../utils/kit/content";

interface Props {
	// all | posts | works | journal | library | library:<书架 id>
	active?: string;
}
const { active = "" } = Astro.props;
const group = active.split(":")[0];

const [feed, shelves, digests] = await Promise.all([getFeed(), getShelvesWithItems(), getMonthDigests()]);
const posts = feed.filter((f) => f.kind === "post");
const works = feed.filter((f) => f.kind === "work");
const notes = digests.filter((d) => d.note).length;
const libraryTotal = shelves.reduce((n, s) => n + s.items.length, 0);

const count = (values: string[]) => {
	const m = new Map<string, number>();
	for (const v of values) m.set(v, (m.get(v) ?? 0) + 1);
	return [...m.entries()].sort((a, b) => b[1] - a[1]).map(([name, n]) => ({ name, count: n }));
};
const postCats = count(posts.map((p) => p.category || "未分类"));
const workGroups = count(works.flatMap((w) => w.tags.filter((t) => t.endsWith("系"))));
const total = posts.length + works.length + libraryTotal + notes;

type Row = {
	label: string;
	href: string;
	icon?: string;
	count?: number;
	sub?: boolean;
	active?: boolean;
	// 当前页面就是这个数据库时，子项变成筛选按钮
	filterCat?: string;
	filterTag?: string;
};
const enc = encodeURIComponent;
const rows: Row[] = [
	{ label: "全部笔记", href: "/", icon: "material-symbols:folder-open-outline-rounded", count: total, active: group === "all" },
	{
		label: "文章",
		href: "/posts/",
		icon: "material-symbols:article-outline-rounded",
		count: posts.length,
		active: group === "posts" ? undefined : false,
		filterCat: group === "posts" ? "" : undefined,
	},
	...(group === "posts" ? postCats : []).map((c) => ({
		label: c.name,
		href: `/posts/?cat=${enc(c.name)}`,
		count: c.count,
		sub: true,
		filterCat: group === "posts" ? c.name : undefined,
	})),
	{
		label: "收藏库",
		href: "/library/",
		icon: "material-symbols:collections-bookmark-outline-rounded",
		count: libraryTotal,
		active: active === "library",
	},
	...(group === "library" ? shelves : []).map((s) => ({
		label: s.shelf.title,
		href: `/library/${s.shelf.id}/`,
		icon: s.shelf.icon,
		count: s.items.length,
		sub: true,
		active: active === `library:${s.shelf.id}`,
	})),
	{
		label: "作品",
		href: "/works/",
		icon: "material-symbols:work-outline",
		count: works.length,
		filterTag: group === "works" ? "" : undefined,
	},
	...(group === "works" ? workGroups : []).map((g) => ({
		label: g.name,
		href: `/works/?tag=${enc(g.name)}`,
		count: g.count,
		sub: true,
		filterTag: group === "works" ? g.name : undefined,
	})),
	{
		label: "月记",
		href: "/journal/",
		icon: "material-symbols:calendar-month-outline-rounded",
		count: digests.length,
		active: group === "journal",
	},
];
---

<WidgetLayout id="kit-vault" name="库">
	<nav class="kit-side__list kit-tree" aria-label="库">
		{
			rows.map((r) => (
				<a
					href={r.href}
					class:list={["kit-side__row", r.sub && "kit-side__row--sub", r.active && "is-active"]}
					aria-current={r.active ? "page" : undefined}
					data-filter-cat={r.filterCat}
					data-filter={r.filterTag}
					aria-pressed={r.filterCat !== undefined || r.filterTag !== undefined ? "false" : undefined}
				>
					{r.icon ? <Icon name={r.icon} class="text-lg flex-none" /> : <span class="kit-tree__dot" aria-hidden="true" />}
					<span>{r.label}</span>
					{r.count !== undefined && <span class="kit-side__badge">{r.count}</span>}
				</a>
			))
		}
	</nav>
</WidgetLayout>
