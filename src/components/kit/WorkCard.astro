---
import { Icon } from "astro-icon/components";
import { dayKey, type FeedItem } from "../../utils/kit/content";
import Cover from "./Cover.astro";

interface Props {
	work: FeedItem;
	index?: number;
	// featured：大卡片，封面在左、信息在右
	featured?: boolean;
}
const { work, index = 0, featured = false } = Astro.props;
// 「作品」分组标签（程序系 / 正常系）和技术标签分开显示
const group = work.tags.find((t) => t.endsWith("系"));
const stack = work.tags.filter((t) => t !== group);
const date = dayKey(work.date);
---

<div
	data-item
	data-reveal
	data-title={work.title}
	data-tags={work.tags.join("|")}
	data-date={date}
	data-featured={featured ? "" : undefined}
	style={`--i: ${Math.min(index, 10)}`}
>
	<article class:list={["card-base", "kit-card", "work", featured && "work--featured"]} data-tilt={featured ? 2 : 4}>
		<a class="kit-card__link" href={work.url} aria-label={work.title}></a>
		<div class="work__cover">
			<Cover src={work.cover} title={work.title} aspect="16 / 10" eager={featured} />
			{group && <span class="work__group">{group}</span>}
		</div>
		<div class="kit-card__body work__body">
			<div class="work__date text-50">
				<Icon name="material-symbols:calendar-today-outline-rounded" class="inline -translate-y-px" />
				{date}
			</div>
			<h3 class="kit-card__title work__title text-90">{work.title}</h3>
			<p class="work__desc text-75">{work.description}</p>
			<div class="kit-card__tags">
				{
					stack.slice(0, featured ? 8 : 4).map((t) => (
						<button type="button" class="kit-tag" data-tag-filter={t} data-tag-href={`/works/?tag=${encodeURIComponent(t)}`} title={`只看「${t}」`}>
							# {t}
						</button>
					))
				}
			</div>
			{
				featured && (
					<div class="work__actions">
						<a class="kit-btn-solid" href={work.url}>
							看看怎么做的 <Icon name="material-symbols:arrow-forward-rounded" />
						</a>
						{work.sourceLink && (
							<a class="btn-regular h-9 px-4 rounded-lg text-sm font-bold gap-1.5" href={work.sourceLink} target="_blank" rel="noopener noreferrer">
								<Icon name="material-symbols:code-rounded" /> 源码
							</a>
						)}
					</div>
				)
			}
		</div>
	</article>
</div>

<style>
	.work__cover {
		position: relative;
	}

	.work__group {
		position: absolute;
		z-index: 2;
		left: 0.6rem;
		top: 0.6rem;
		padding: 0.2rem 0.55rem;
		border-radius: 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: white;
		background: rgb(0 0 0 / 0.5);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.work__body {
		padding: 0.9rem 1rem 1rem;
	}

	.work__date {
		font-family: var(--kit-num);
		font-size: 0.75rem;
	}

	.work__title {
		font-size: 1.1rem;
	}

	.work__desc {
		font-size: 0.875rem;
		line-height: 1.65;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.work__actions {
		position: relative;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.5rem;
	}

	@media (min-width: 768px) {
		.work--featured {
			flex-direction: row;
			align-items: stretch;
		}

		.work--featured .work__cover {
			flex: 0 0 52%;
		}

		.work--featured .work__cover :global(.kit-cover) {
			height: 100%;
		}

		.work--featured .work__body {
			padding: 1.75rem 2rem;
			justify-content: center;
			gap: 0.7rem;
		}

		.work--featured .work__title {
			font-size: 1.75rem;
		}

		.work--featured .work__desc {
			font-size: 0.95rem;
			-webkit-line-clamp: 4;
		}
	}

	/* 列表视图下的作品卡 */
	:global(.kit-grid.is-list) .work .work__cover {
		flex: 0 0 9rem;
	}

	:global(.kit-grid.is-list) .work .work__desc {
		-webkit-line-clamp: 1;
	}
</style>
