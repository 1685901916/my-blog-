---
// 左栏分类筛选：外观和主题的「分类」小组件一致，点一行只看这个分类（再点取消）
// 需要放在 KitShell collection 作用域里；卡片外层要有 data-cat
import WidgetLayout from "../widget/WidgetLayout.astro";

interface Props {
	id: string;
	title: string;
	cats: Array<{ name: string; count: number }>;
	total: number;
}
const { id, title, cats, total } = Astro.props;
---

{
	cats.length > 0 && (
		<WidgetLayout id={id} name={title}>
			<div class="kit-side__list" role="group" aria-label={title}>
				<button type="button" class="kit-side__row" data-filter-cat="" aria-pressed="true">
					<span>全部</span>
					<span class="kit-side__badge">{total}</span>
				</button>
				{cats.map((c) => (
					<button type="button" class="kit-side__row" data-filter-cat={c.name} aria-pressed="false">
						<span>{c.name}</span>
						<span class="kit-side__badge">{c.count}</span>
					</button>
				))}
			</div>
		</WidgetLayout>
	)
}
