---
// 数据库视图顶部的工具条，照 Obsidian Bases 的样子：
// 第一行面包屑（最后一项就是页面标题 h1），第二行放工具栏（toolbar 插槽）
interface Props {
	crumbs?: Array<{ label: string; href?: string }>;
	title: string;
}
const { crumbs = [], title } = Astro.props;
---

<header class="card-base kit-bar onload-animation">
	<nav class="kit-bar__crumbs" aria-label="位置">
		<a href="/" class="text-50">库</a>
		{
			crumbs.map((c) => (
				<>
					<span class="kit-bar__sep" aria-hidden="true">/</span>
					{c.href ? (
						<a href={c.href} class="text-50">
							{c.label}
						</a>
					) : (
						<span class="text-50">{c.label}</span>
					)}
				</>
			))
		}
		<span class="kit-bar__sep" aria-hidden="true">/</span>
		<h1 class="kit-bar__title text-90">{title}</h1>
	</nav>
	{Astro.slots.has("toolbar") && <div class="kit-bar__tools"><slot name="toolbar" /></div>}
	<slot />
</header>
