---
// 文章 / 作品 / 月记共用的卡片：封面（没有就用字体封面）+ 分类 + 标题 + 简介 + 标签 + 日期
import { dayKey, type FeedItem, KIND_LABEL } from "../../utils/kit/content";
import Cover from "./Cover.astro";

interface Props {
	item: FeedItem;
	index?: number;
	// 主页上按类型（文章 / 作品 / 月记）筛选，文章库里按分类筛选
	catBy?: "kind" | "category";
	// 全部笔记视图：分组顺序；和海报卡片混排时占两列
	catOrder?: number;
	mixed?: boolean;
}
const { item, index = 0, catBy = "category", catOrder, mixed = false } = Astro.props;
const date = dayKey(item.date);
const cat = catBy === "kind" ? KIND_LABEL[item.kind] : item.category || "未分类";
const label = catBy === "kind" ? KIND_LABEL[item.kind] : item.category || KIND_LABEL[item.kind];
// 作品的「程序系 / 正常系」、和分类同名的标签不重复显示
const tags = item.tags.filter((t) => t !== item.category && t !== label);
// 不在卡片视图里时，点标签跳到对应数据库的筛选结果
const tagBase = { post: "/posts/", work: "/works/", journal: "/journal/" }[item.kind];
const tagHref = (t: string) => (item.kind === "journal" ? tagBase : `${tagBase}?tag=${encodeURIComponent(t)}`);
---

<div
	data-item
	data-reveal
	data-title={item.title}
	data-tags={item.tags.join("|")}
	data-cat={cat}
	data-cat-order={catOrder}
	data-wide={mixed ? "" : undefined}
	data-date={date}
	style={`--i: ${Math.min(index, 10)}`}
>
	<article class="card-base kit-card article">
		<a class="kit-card__link" href={item.url} aria-label={item.title}></a>
		<Cover src={item.cover} title={item.title} aspect="16 / 10" />
		<div class="kit-card__body">
			<h3 class="kit-card__title article__title text-90">{item.title}</h3>
			{item.description && <p class="article__desc text-75">{item.description}</p>}
			<!-- 最后一行：分类 · 日期 · 标签 -->
			<div class="article__foot">
				<span class="article__cat">{label}</span>
				<span class="article__date text-50">{date}</span>
				{
					tags.slice(0, 3).map((t) => (
						<button type="button" class="kit-tag" data-tag-filter={t} data-tag-href={tagHref(t)} title={`只看「${t}」`}>
							# {t}
						</button>
					))
				}
			</div>
		</div>
	</article>
</div>

<style>
	.article__title {
		white-space: normal;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.article__desc {
		font-size: 0.875rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.article__foot {
		position: relative;
		z-index: 2;
		margin-top: auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.15rem 0.65rem;
		font-size: 0.75rem;
	}

	.article__cat {
		color: var(--primary);
		font-weight: 700;
	}

	.article__date {
		font-family: var(--kit-num);
	}

	/* 列表视图：左边小缩略图，右边「标题 / 简介 / 分类·日期·标签」三行 */
	:global(.kit-grid.is-list) .article :global(.kit-cover) {
		width: 7rem;
		aspect-ratio: 16 / 10;
	}

	:global(.kit-grid.is-list) .article :global(.kit-card__body) {
		flex-direction: column;
		align-items: stretch;
		gap: 0.3rem;
		padding: 0.8rem 1.1rem;
	}

	/* 通用列表规则给标题设了 flex-basis（横排用），竖排时会变成高度，这里取消 */
	:global(.kit-grid.is-list) .article :global(.kit-card__title) {
		flex: none;
	}

	:global(.kit-grid.is-list) .article__desc {
		-webkit-line-clamp: 1;
	}
</style>
