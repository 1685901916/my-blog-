---
// 方案 B 的卡片，按内容长不同样子：
//   text   文章 / 随笔 / 收集：分类（小圆点 + 字）+ 标题 + 摘要 + 标签，不放截图
//   poster 动画 / 漫画 / 小说 / 游戏：竖版海报，评分做成海报上的小角标；没海报时是经典书封（纸色 + 衬线书名）
//   person 人物：纸色底的竖版人像，名字写在下面（白底立绘会融进纸色里）
//   shot   作品：项目截图 + 标题 + 摘要
//   month  月记：大号月份 + 标题 + 摘要
//   line   收集：没有卡片框的列表行（分类 · 日期 / 标题 / 一行摘要）
// feature = true：横版大卡（左图右文），总览里第一篇文章用
// engine = true 时带上 data-*，交给 kit.ts 的卡片引擎筛选 / 排序
import { Icon } from "astro-icon/components";
import { type BaseRow, hueOf } from "./proto";

interface Props {
	row: BaseRow;
	index?: number;
	engine?: boolean;
	feature?: boolean;
}
const { row, index = 0, engine = true, feature = false } = Astro.props;
const v = row.variant;
// 分类色：只用一组低饱和的颜色，不用彩虹色
const PAPER = ["paper-1", "paper-2", "paper-3", "paper-4", "paper-5", "paper-6"];
const tone = PAPER[hueOf(row.cat || row.kind) % PAPER.length];
const paper = PAPER[hueOf(row.title) % PAPER.length];
const [y, m] = row.date.split("-");
const initial = [...row.title.replace(/^[^\p{L}\p{N}]+/u, "")][0] ?? "?";
---

<div
	class:list={["bc-cell", `is-${v}`, feature && "is-feature"]}
	data-item={engine ? "" : undefined}
	data-reveal
	data-title={row.title}
	data-kind={row.kind}
	data-kind-order={row.kindOrder}
	data-tags={row.tags.join("|")}
	data-cat={row.cat}
	data-date={row.date}
	data-rating={row.rating ?? ""}
	data-rank={row.rank}
	style={`--i: ${Math.min(index, 10)}`}
>
	<a href={row.href} class:list={["bc", `bc--${v}`, feature && "bc--feature"]}>
		{
			v === "poster" && (
				<>
					<div class:list={["bc__poster", !row.cover && ["is-book", paper]]}>
						{row.cover ? (
							<img src={row.cover} alt="" loading="lazy" referrerpolicy="no-referrer" />
						) : (
							<span class="bc__book">
								<b>{row.title}</b>
								<small>{row.kind}</small>
							</span>
						)}
						{typeof row.rating === "number" && (
							<span class="bc__score">
								<Icon name="material-symbols:star-rounded" />
								{row.rating.toFixed(1)}
							</span>
						)}
						{row.marks.includes("heart") && <Icon name="material-symbols:favorite-rounded" class="bc__heart" />}
					</div>
					<div class="bc__name">{row.title}</div>
					<div class="bc__meta">
						{row.cat || row.kind}
						{row.marks.includes("star") && <span class="bc__rec">推荐</span>}
					</div>
				</>
			)
		}
		{
			v === "person" && (
				<>
					<div class:list={["bc__portrait", paper, !row.cover && "is-empty"]}>
						{row.cover ? <img src={row.cover} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="bc__initial">{initial}</span>}
						{row.marks.includes("heart") && <Icon name="material-symbols:favorite-rounded" class="bc__heart" />}
					</div>
					<div class="bc__name">{row.title}</div>
					<div class="bc__meta">{row.cat}</div>
				</>
			)
		}
		{
			v === "line" && (
				<>
					<div class="bc__top">
						{row.cat && <span class:list={["bc__cat", tone]}>{row.cat}</span>}
						<time>{row.date}</time>
					</div>
					<div class="bc__title">{row.title}</div>
					{row.excerpt && <p class="bc__excerpt">{row.excerpt}</p>}
				</>
			)
		}
		{
			(v === "text" || v === "shot" || v === "month") && (
				<>
					{v === "shot" && (
						<div class:list={["bc__shot", !row.cover && ["is-empty", paper]]}>
							{row.cover ? <img src={row.cover} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span>{row.title}</span>}
						</div>
					)}
					{v === "month" && (
						<div class:list={["bc__month", paper]}>
							<b>{m}</b>
							<small>{y}</small>
						</div>
					)}
					<div class="bc__body">
						<div class="bc__top">
							{row.cat && <span class:list={["bc__cat", tone]}>{row.cat}</span>}
							{row.pinned && <span class="bc__pin">置顶</span>}
							<time>{row.date}</time>
						</div>
						<div class="bc__title">{row.title}</div>
						{row.excerpt && <p class="bc__excerpt">{row.excerpt}</p>}
						<div class="bc__foot">
							<span class="bc__tags">
								{row.tags.slice(0, 3).map((t) => (
									<span>#{t}</span>
								))}
							</span>
							{row.words > 0 && <span class="bc__words">{row.words} 字</span>}
						</div>
					</div>
				</>
			)
		}
	</a>
</div>

<style>
	/* 一组纸色（书封、月份、人物占位、分类圆点共用），低饱和，亮暗两套 */
	.bc-cell {
		--serif: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
	}

	.paper-1 { --paper: #efe6d4; --ink: #5b4a2e; --dot: #c09a5b; }
	.paper-2 { --paper: #dfe7da; --ink: #3f5a40; --dot: #7c9b78; }
	.paper-3 { --paper: #efdcd9; --ink: #6b3a39; --dot: #c98580; }
	.paper-4 { --paper: #dce2ea; --ink: #34465c; --dot: #7a90ab; }
	.paper-5 { --paper: #e5ddec; --ink: #4f3f62; --dot: #9a86b4; }
	.paper-6 { --paper: #dde9e7; --ink: #2f5652; --dot: #6fa39c; }

	:global(:root.dark) .paper-1 { --paper: #3a3327; --ink: #ecdcbc; }
	:global(:root.dark) .paper-2 { --paper: #2d382d; --ink: #cfe0cb; }
	:global(:root.dark) .paper-3 { --paper: #3d2c2b; --ink: #f0cfcb; }
	:global(:root.dark) .paper-4 { --paper: #2b3240; --ink: #cbd7e8; }
	:global(:root.dark) .paper-5 { --paper: #352d40; --ink: #ddd0ec; }
	:global(:root.dark) .paper-6 { --paper: #283a38; --ink: #c6e3df; }

	.bc {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-width: 0;
	}

	/* ---------- 海报 ---------- */
	.bc__poster,
	.bc__portrait {
		position: relative;
		overflow: hidden;
		background: var(--db-sunk);
		box-shadow:
			inset 0 0 0 1px rgb(0 0 0 / 0.06),
			0 1px 2px rgb(0 0 0 / 0.06);
		transition:
			transform 0.5s var(--kit-spring),
			box-shadow 0.35s;
	}

	.bc__poster {
		aspect-ratio: 2 / 3;
		border-radius: 0.55rem;
	}

	.bc:hover .bc__poster,
	.bc:hover .bc__portrait {
		transform: translateY(-5px);
		box-shadow: 0 22px 36px -22px rgb(0 0 0 / 0.6);
	}

	.bc__poster img,
	.bc__portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.bc__score {
		position: absolute;
		left: 0.45rem;
		bottom: 0.45rem;
		display: inline-flex;
		align-items: center;
		gap: 0.1rem;
		padding: 0.1rem 0.4rem 0.1rem 0.3rem;
		border-radius: 0.35rem;
		font-family: var(--kit-num);
		font-size: 0.75rem;
		font-weight: 800;
		color: white;
		background: rgb(20 20 24 / 0.6);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.bc__score :global(svg) {
		font-size: 0.85rem;
		color: #ffc94a;
	}

	.bc__heart {
		position: absolute;
		top: 0.45rem;
		right: 0.45rem;
		font-size: 1.15rem;
		color: #ff5f86;
		filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.45));
	}

	/* 没海报：经典书封（纸色 + 内框 + 衬线书名 + 书脊阴影） */
	.bc__poster.is-book {
		background:
			linear-gradient(90deg, rgb(0 0 0 / 0.1), rgb(0 0 0 / 0) 7%, rgb(255 255 255 / 0.25) 8%, rgb(255 255 255 / 0) 11%),
			var(--paper);
	}

	.bc__book {
		position: absolute;
		inset: 9% 9% 9% 13%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 0.6rem;
		text-align: center;
		color: var(--ink);
		border: 1px solid color-mix(in oklch, var(--ink) 35%, transparent);
	}

	.bc__book::before,
	.bc__book::after {
		content: "";
		width: 1.25rem;
		height: 1px;
		background: currentColor;
		opacity: 0.45;
	}

	.bc__book b {
		font-family: var(--serif);
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.bc__book small {
		order: 3;
		font-size: 0.62rem;
		letter-spacing: 0.3em;
		opacity: 0.7;
	}

	.bc__name {
		margin-top: 0.6rem;
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1.35;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 0.15s;
	}

	.bc:hover .bc__name,
	.bc:hover .bc__title {
		color: var(--primary);
	}

	.bc__meta {
		margin-top: 0.15rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		color: var(--db-muted);
		overflow: hidden;
		white-space: nowrap;
	}

	.bc__rec {
		font-size: 0.68rem;
		font-weight: 700;
		color: #c9921c;
	}

	/* ---------- 人物：纸色底人像，名字在下面 ---------- */
	.bc__portrait {
		aspect-ratio: 3 / 4;
		border-radius: 0.75rem;
		background: var(--paper);
	}

	/* 亮色下立绘的白底融进纸色；暗色下保持原图 */
	.bc__portrait img {
		object-position: center 12%;
		mix-blend-mode: multiply;
	}

	:global(:root.dark) .bc__portrait img {
		mix-blend-mode: normal;
	}

	.bc__initial {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-family: var(--serif);
		font-size: 2.6rem;
		font-weight: 700;
		color: var(--ink);
		opacity: 0.8;
	}

	.bc__portrait .bc__heart {
		top: 0.5rem;
		right: 0.5rem;
	}

	/* ---------- 列表行（收集）：没有卡片框，上下细线分隔 ---------- */
	.bc--line {
		display: grid;
		grid-template-areas: "top" "title" "excerpt";
		align-content: start;
		gap: 0.3rem;
		padding: 1rem 0.15rem 1.1rem;
		border-top: 1px solid var(--db-line);
	}

	.bc--line .bc__top {
		grid-area: top;
	}

	.bc--line .bc__title {
		grid-area: title;
		font-size: 1rem;
		-webkit-line-clamp: 1;
	}

	.bc--line .bc__excerpt {
		grid-area: excerpt;
		font-size: 0.82rem;
		-webkit-line-clamp: 1;
		color: var(--db-muted);
	}

	/* ---------- 文字卡 / 截图卡 / 月份卡 ---------- */
	.bc--text,
	.bc--shot,
	.bc--month {
		overflow: hidden;
		border-radius: 0.9rem;
		background: var(--db-card);
		box-shadow:
			0 0 0 1px var(--db-line),
			0 1px 2px rgb(0 0 0 / 0.03);
		transition:
			transform 0.5s var(--kit-spring),
			box-shadow 0.3s;
	}

	.bc--text:hover,
	.bc--shot:hover,
	.bc--month:hover {
		transform: translateY(-3px);
		box-shadow:
			0 0 0 1px color-mix(in oklch, var(--db-line) 55%, var(--primary)),
			0 22px 40px -30px rgb(0 0 0 / 0.55);
	}

	.bc__shot {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--db-sunk);
	}

	.bc__shot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.7s var(--kit-ease-out);
	}

	/* 作品没有截图：纸色扉页 + 衬线标题 */
	.bc__shot.is-empty {
		display: grid;
		place-items: center;
		padding: 1.5rem;
		background: var(--paper);
	}

	.bc__shot.is-empty span {
		font-family: var(--serif);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.5;
		text-align: center;
		color: var(--ink);
	}

	.bc--shot:hover .bc__shot img {
		transform: scale(1.03);
	}

	.bc--month {
		flex-direction: row;
	}

	.bc__month {
		flex: none;
		width: 5.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background: var(--paper);
		color: var(--ink);
	}

	.bc__month b {
		font-family: var(--serif);
		font-size: 2.3rem;
		font-weight: 700;
		line-height: 1;
	}

	.bc__month small {
		margin-top: 0.3rem;
		font-family: var(--kit-num);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		opacity: 0.75;
	}

	.bc__body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
		padding: 1.1rem 1.25rem 1rem;
	}

	.bc__top {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.75rem;
	}

	.bc__cat {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 700;
		color: var(--db-soft);
	}

	.bc__cat::before {
		content: "";
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--dot);
	}

	.bc__pin {
		font-weight: 700;
		color: var(--primary);
	}

	.bc__top time {
		margin-left: auto;
		font-family: var(--kit-num);
		color: var(--db-muted);
	}

	.bc__title {
		font-size: 1.08rem;
		font-weight: 800;
		line-height: 1.45;
		color: var(--db-text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.15s;
	}

	.bc__excerpt {
		font-size: 0.85rem;
		line-height: 1.75;
		color: var(--db-soft);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.bc__foot {
		margin-top: auto;
		padding-top: 0.4rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.75rem;
		color: var(--db-muted);
	}

	.bc__tags {
		display: flex;
		gap: 0.65rem;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
	}

	.bc__words {
		margin-left: auto;
		flex: none;
		font-family: var(--kit-num);
	}

	/* ---------- 横版大卡：左图右文，和旁边的普通卡片一样高 ---------- */
	.bc--feature {
		flex-direction: row;
	}

	.bc--feature .bc__shot {
		flex: 0 0 56%;
		aspect-ratio: auto;
		height: auto;
		min-height: 100%;
	}

	.bc--feature .bc__body {
		justify-content: center;
		gap: 0.7rem;
		padding: 1.6rem 1.75rem;
	}

	.bc--feature .bc__title {
		font-family: var(--serif);
		font-size: 1.6rem;
		font-weight: 900;
		line-height: 1.35;
		-webkit-line-clamp: 3;
	}

	.bc--feature .bc__excerpt {
		font-size: 0.92rem;
		-webkit-line-clamp: 4;
	}

	.bc--feature .bc__foot {
		margin-top: 0.5rem;
	}

	@media (max-width: 760px) {
		.bc--feature {
			flex-direction: column;
		}

		.bc--feature .bc__shot {
			flex: none;
			aspect-ratio: 16 / 10;
			min-height: 0;
		}

		.bc--feature .bc__body {
			padding: 1.1rem 1.25rem 1rem;
		}

		.bc--feature .bc__title {
			font-size: 1.3rem;
		}
	}

	/* ---------- 列表视图：所有类型都压成一行 ---------- */
	:global(.kit-grid.is-list) .bc {
		flex-direction: row;
		align-items: center;
		gap: 0.9rem;
		padding: 0.55rem 0.9rem;
		border-radius: 0.6rem;
		background: var(--db-card);
		box-shadow: 0 0 0 1px var(--db-line);
		transform: none;
	}

	:global(.kit-grid.is-list) .bc__poster,
	:global(.kit-grid.is-list) .bc__portrait {
		width: 2.4rem;
		flex: none;
		border-radius: 0.35rem;
		transform: none;
		box-shadow: none;
	}

	:global(.kit-grid.is-list) .bc__book,
	:global(.kit-grid.is-list) .bc__score,
	:global(.kit-grid.is-list) .bc__heart,
	:global(.kit-grid.is-list) .bc__initial,
	:global(.kit-grid.is-list) .bc__shot,
	:global(.kit-grid.is-list) .bc__month,
	:global(.kit-grid.is-list) .bc__excerpt,
	:global(.kit-grid.is-list) .bc__foot {
		display: none;
	}

	:global(.kit-grid.is-list) .bc--person .bc__portrait {
		aspect-ratio: 1;
		border-radius: 999px;
	}

	:global(.kit-grid.is-list) .bc__name {
		flex: 1;
		margin: 0;
		font-size: 0.92rem;
	}

	:global(.kit-grid.is-list) .bc__meta {
		margin: 0;
	}

	:global(.kit-grid.is-list) .bc__body {
		flex-direction: row;
		align-items: center;
		padding: 0.15rem 0;
		gap: 1rem;
	}

	:global(.kit-grid.is-list) .bc__top {
		flex: none;
		min-width: 13rem;
	}

	:global(.kit-grid.is-list) .bc__title {
		order: -1;
		flex: 1;
		font-size: 0.92rem;
		-webkit-line-clamp: 1;
	}
</style>
