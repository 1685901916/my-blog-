---
// 方案 1 的条目卡片：作品 = 竖版海报 + 标题 + 星级；人物 = 圆形头像 + 名字；其他 = 文字卡片
// 带 data-* 属性时可以交给 kit.ts 的卡片引擎筛选（分类 = 第一层子文件夹）
import { Icon } from "astro-icon/components";
import { type AcgItem, coverOf, initialOf, starsOf } from "../acg";

interface Props {
	item: AcgItem;
	engine?: boolean;
	index?: number;
}
const { item, engine = false, index = 0 } = Astro.props;
const href = `/preview/1/i/${item.id}/`;
const img = coverOf(item);
const kind = item.section.kind;
const stars = starsOf(item.rating);
---

<div
	class:list={["entry", `is-${kind}`]}
	data-item={engine ? "" : undefined}
	data-reveal
	data-title={item.title}
	data-cat={item.sub[0] ?? ""}
	data-tags={item.tags.join("|")}
	data-date={item.date}
	data-rating={item.rating ?? (item.marks.length ? 5 + item.marks.length : "")}
	style={`--i: ${Math.min(index, 12)}`}
>
	<a href={href} class="entry__link">
		<div class="entry__pic">
			{img ? <img src={img} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="entry__initial">{initialOf(item)}</span>}
			{
				item.marks.length > 0 && (
					<span class="entry__marks">
						{item.marks.includes("heart") && <Icon name="material-symbols:favorite-rounded" title="喜欢" />}
						{item.marks.includes("star") && <Icon name="material-symbols:star-rounded" title="推荐" />}
					</span>
				)
			}
		</div>
		<div class="entry__title">{item.title}</div>
		{
			kind === "work" && (
				<div class="entry__meta">
					{stars > 0 ? (
						<span class="entry__stars" style={`--s: ${stars}`} title={`${item.rating} 分`}>
							<b>{item.rating?.toFixed(1)}</b>
						</span>
					) : (
						<span>{item.sub.at(-1) ?? item.section.name}</span>
					)}
				</div>
			)
		}
		{kind !== "work" && item.excerpt && <div class="entry__excerpt">{item.excerpt}</div>}
	</a>
</div>

<style>
	.entry__link {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}

	.entry__pic {
		position: relative;
		overflow: hidden;
		aspect-ratio: 3 / 4;
		border-radius: 0.45rem;
		background: color-mix(in oklch, var(--card-bg) 88%, var(--primary));
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
		transition:
			transform 0.4s var(--kit-spring),
			box-shadow 0.3s;
	}

	.entry__link:hover .entry__pic {
		transform: translateY(-3px);
		box-shadow: 0 14px 28px -16px rgb(0 0 0 / 0.5);
	}

	.entry__pic img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.entry__initial {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 2.6rem;
		font-weight: 900;
		color: color-mix(in oklch, var(--primary) 70%, white);
	}

	.entry__marks {
		position: absolute;
		top: 0.35rem;
		right: 0.35rem;
		display: flex;
		gap: 0.15rem;
		padding: 0.15rem 0.3rem;
		border-radius: 0.35rem;
		font-size: 0.8rem;
		color: #ffd166;
		background: rgb(0 0 0 / 0.5);
	}

	.entry__marks :global(svg:first-child) {
		color: #ff7a9c;
	}

	.entry__marks :global(svg:only-child[title="推荐"]) {
		color: #ffd166;
	}

	.entry__title {
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1.35;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 0.15s;
	}

	.entry__link:hover .entry__title {
		color: var(--primary);
	}

	.entry__meta {
		margin-top: -0.2rem;
		font-size: 0.75rem;
		color: var(--p1-muted, #999);
	}

	/* 星级：底色灰星 + 按分数裁出的粉星 */
	.entry__stars {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.entry__stars::before {
		content: "★★★★★";
		letter-spacing: 1px;
		font-size: 0.75rem;
		background: linear-gradient(to right, #f5b400 calc(var(--s) / 5 * 100%), color-mix(in oklch, var(--card-bg) 80%, black) 0);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.entry__stars b {
		font-family: var(--kit-num);
		color: var(--p1-soft, #666);
	}

	/* 人物：圆形头像，名字居中 */
	.is-person .entry__link {
		align-items: center;
		text-align: center;
	}

	.is-person .entry__pic {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 999px;
	}

	.is-person .entry__title {
		max-width: 100%;
	}

	.entry__excerpt {
		margin-top: -0.2rem;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--p1-muted, #999);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* 其他：横向文字卡片 */
	.is-misc .entry__link {
		flex-direction: row;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0.8rem;
		border-radius: 0.6rem;
		background: var(--p1-card, var(--card-bg));
		border: 1px solid var(--p1-line, rgb(0 0 0 / 0.08));
		transition: border-color 0.15s;
	}

	.is-misc .entry__link:hover {
		border-color: var(--primary);
	}

	.is-misc .entry__pic {
		width: 2.75rem;
		flex: none;
		aspect-ratio: 1;
		border-radius: 0.5rem;
	}

	.is-misc .entry__initial {
		font-size: 1.15rem;
	}

	.is-misc .entry__marks {
		display: none;
	}

	.is-misc .entry__title {
		flex: 1;
	}

	.is-misc .entry__excerpt {
		display: none;
	}
</style>
