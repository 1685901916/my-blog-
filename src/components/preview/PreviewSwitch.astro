---
// 预览方案切换（只在 /preview/ 下的原型页用）
interface Props {
	current: "a" | "b";
}
const { current } = Astro.props;
const items = [
	{ id: "a", label: "A 应用式" },
	{ id: "b", label: "B 主页 + 数据库" },
];
---

<nav class="pv-switch" aria-label="切换方案" data-no-swup>
	{
		items.map((i) => (
			<a href={`/preview/${i.id}/`} class:list={["pv-switch__item", i.id === current && "is-on"]}>
				{i.label}
			</a>
		))
	}
	<a href="/" class="pv-switch__item pv-switch__back">现版</a>
</nav>

<style>
	.pv-switch {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 90;
		display: flex;
		gap: 0.25rem;
		padding: 0.3rem;
		border-radius: 999px;
		background: rgb(20 20 20 / 0.82);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.5);
	}

	.pv-switch__item {
		padding: 0.45rem 0.9rem;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 600;
		color: rgb(255 255 255 / 0.7);
		white-space: nowrap;
		transition:
			background 0.2s,
			color 0.2s;
	}

	.pv-switch__item:hover {
		color: white;
	}

	.pv-switch__item.is-on {
		background: white;
		color: rgb(20 20 20);
	}

	.pv-switch__back {
		color: rgb(255 255 255 / 0.45);
	}

	@media (max-width: 640px) {
		.pv-switch {
			left: 0.75rem;
			right: 0.75rem;
			justify-content: center;
		}

		.pv-switch__item {
			padding: 0.4rem 0.6rem;
			font-size: 0.75rem;
		}
	}
</style>
